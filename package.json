{
  "name": "my-v0-project",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "lint": "eslint .",
    "start": "next start",
    "postinstall": "prisma generate && npm run pdf:assets",
    "test": "node --test tests/*.test.cjs",
    "test:migrations": "node tests/authorization-migration.cjs",
    "typecheck": "tsc --noEmit",
    "validate": "npm run test && npm run test:migrations && npm run lint && npm run typecheck && npm run build",
    "db:deploy": "node scripts/check-migration-path.cjs && prisma migrate deploy",
    "db:check-path": "node scripts/check-migration-path.cjs",
    "db:check-release": "node scripts/check-release-database.cjs",
    "test:settings:e2e": "node scripts/run-onboarding-e2e.cjs --settings",
    "test:onboarding:e2e": "node scripts/run-onboarding-e2e.cjs",
    "test:panel-publication:e2e": "node scripts/run-availability-e2e.cjs --publication",
    "test:panels:e2e": "node scripts/run-availability-e2e.cjs --panels",
    "test:scheduling-quality:e2e": "node scripts/run-availability-e2e.cjs --audit",
    "test:scheduling-ux:e2e": "node scripts/run-availability-e2e.cjs --ux",
    "test:availability:e2e": "node scripts/run-availability-e2e.cjs",
    "pdf:assets": "node scripts/copy-pdfjs-assets.cjs",
    "predev": "npm run pdf:assets",
    "prebuild": "node scripts/check-release-database.cjs --vercel-production-build && npm run pdf:assets",
    "email:templates": "node scripts/email-audit.cjs build",
    "email:previews": "node scripts/email-design.cjs render"
  },
