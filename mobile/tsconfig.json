{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "~/*": [
        "./src/*"
      ],
      "phosphor-react-native/src/icons/*": [
        "./src/types/phosphor-icons.d.ts"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "app.config.ts",
    "ios",
    "android",
    "node_modules",
    "__tests__",
    "jest.config.js"
  ]
}
