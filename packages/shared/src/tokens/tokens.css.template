/* OutClass foundations: the single palette for every surface. Semantic variables are the source of truth; Tailwind
   and the existing shadcn APIs consume them through app/globals.css. */
:root {
  /* School theme layer. UVA is the default school. Values from brand.virginia.edu/design-assets/colors
     and its accessible type-colour combinations (verified 2026-11-08). Another school overrides only these
     four under [data-school="<id>"] (template at the end of this file); everything else reads them through
     the semantic tokens below. lib/qr keeps its own constants. */
  --school-primary: {{school.school-primary}};     /* UVA Blue */
  --school-accent: {{school.school-accent}};      /* UVA Orange: accents, large text (24px, or 18.66px bold) and UI parts only (3.1:1 on white) */
  --school-accent-text: {{school.school-accent-text}}; /* OutClass-derived UVA-hue orange for small text: >= 4.5:1 on every light surface, tinted ones included */
  --school-ring: {{school.school-ring}};        /* the one focus ring: >= 3:1 on canvas, cards, soft panels, UVA Blue and the projector theme */
  --school-accent-on-dark: {{school.school-accent-on-dark}}; /* accent text on navy and dark surfaces (footer, hero, projector): >= 4.5:1 on UVA Blue */
  /* Two-colour focus indicator (WCAG C40): where the ring sits on or inside a filled element, a cream halo
     separates it from the fill (ring vs halo 3.94:1; halo vs the darkest navy pill 9:1+). Owner decision 2026-11-08. */
  --focus-halo: {{root.focus-halo}};
  /* The halo as a shadow: outset fills the 2px gap inside an outset ring; inset-N fills from the edge to an
     inset ring (N = |outline-offset| + outline width). Page CSS uses these instead of raw shadow literals. */
  --focus-halo-outset: {{root.focus-halo-outset}};
  --focus-halo-inset-4: {{root.focus-halo-inset-4}};
  --focus-halo-inset-5: {{root.focus-halo-inset-5}};
  --focus-halo-inset-6: {{root.focus-halo-inset-6}};

  /* Editorial composition: display scale is independent of operational controls. */
  --oc-editorial-display: {{root.oc-editorial-display}};
  --oc-editorial-feature: {{root.oc-editorial-feature}};
  --oc-editorial-section: {{root.oc-editorial-section}};
  --oc-editorial-gap: {{root.oc-editorial-gap}};
  --oc-editorial-radius: {{root.oc-editorial-radius}};
  --oc-editorial-rule: {{root.oc-editorial-rule}};

  /* Content geometry is shared across public forms, product and focused modes.
     Navigation owns its separate optical materials and geometry. */
  --oc-content-width: {{root.oc-content-width}};
  --oc-reading-width: {{root.oc-reading-width}};
  /* Content surfaces are glass (styles/navigation-glass.css). The solid values remain for data tables,
     form fields and every fallback; --oc-surface-glass* resolve to them when glass is unavailable. */
  --oc-content-solid: {{root.oc-content-solid}};
  --oc-content-edge-solid: {{root.oc-content-edge-solid}};
  --oc-content-shadow-solid: {{root.oc-content-shadow-solid}};
  --oc-content-surface: {{root.oc-content-surface}};
  --oc-content-soft: {{root.oc-content-soft}};
  --oc-content-soft-blue: {{root.oc-content-soft-blue}};
  --oc-content-edge: {{root.oc-content-edge}};
  --oc-content-radius: {{root.oc-content-radius}};
  --oc-content-radius-small: {{root.oc-content-radius-small}};
  --oc-content-padding: {{root.oc-content-padding}};
  --oc-content-gap: {{root.oc-content-gap}};
  --oc-content-shadow: {{root.oc-content-shadow}};
  --oc-content-shadow-hover: {{root.oc-content-shadow-hover}};
  --oc-content-motion: {{root.oc-content-motion}};
  --oc-overlay-radius: {{root.oc-overlay-radius}};
  --background: {{root.background}};
  --foreground: {{root.foreground}};
  --card: {{root.card}};
  --card-foreground: {{root.card-foreground}};
  --popover: {{root.popover}};
  --popover-foreground: {{root.popover-foreground}};
  --primary: {{root.primary}};
  --primary-foreground: {{root.primary-foreground}};
  --secondary: {{root.secondary}};
  --secondary-foreground: {{root.secondary-foreground}};
  --muted: {{root.muted}};
  --muted-foreground: {{root.muted-foreground}};
  --accent: {{root.accent}};
  --accent-foreground: {{root.accent-foreground}};
  --brand-orange: {{root.brand-orange}};
  --brand-subtle: {{root.brand-subtle}};
  --brand-ink: {{root.brand-ink}};
  --destructive: {{root.destructive}};
  --destructive-foreground: {{root.destructive-foreground}};
  --error-subtle: {{root.error-subtle}};
  --success: {{root.success}};
  --success-subtle: {{root.success-subtle}};
  --warning: {{root.warning}};
  --warning-subtle: {{root.warning-subtle}};
  --info: {{root.info}};
  --info-subtle: {{root.info-subtle}};
  --interview: {{root.interview}};
  --interview-subtle: {{root.interview-subtle}};
  --border: {{root.border}};
  --input: {{root.input}};
  --ring: {{root.ring}};
  --overlay: {{root.overlay}};
  --chart-1: {{root.chart-1}};
  --chart-2: {{root.chart-2}};
  --chart-3: {{root.chart-3}};
  --chart-4: {{root.chart-4}};
  --chart-5: {{root.chart-5}};
  /* One radius scale (FE-8, owner decision 2026-11-09: consolidate at the current glass look). Every radius in
     component CSS is a step of this scale; content, editorial and overlay radii are aliases of it. */
  --oc-radius-sm: {{root.oc-radius-sm}};   /*  6px inputs, chips, small controls */
  --oc-radius-md: {{root.oc-radius-md}};   /* 10px buttons, list rows */
  --oc-radius-lg: {{root.oc-radius-lg}};      /* 16px panels, cards, sheets */
  --oc-radius-xl: {{root.oc-radius-xl}};  /* 22px feature cards, hero surfaces */
  --oc-radius-2xl: {{root.oc-radius-2xl}};   /* 24px dialogs, overlays, editorial blocks */
  --oc-radius-full: {{root.oc-radius-full}};   /* pills, avatars, capsules */
  --radius: {{root.radius}};
  /* Three elevation levels: surface (panels and cards; the glass depth), popover (menus, popovers,
     toasts), modal (dialogs, sheets). Hover is a state of the surface level, not a level. Raised controls
     inside a surface (active tab, board cards, list rows) keep a 1px contact shadow (--oc-shadow-surface),
     a hairline edge cue, not an elevation, and it stays visible when the glass depth is turned off. */
  --oc-elevation-surface: {{root.oc-elevation-surface}};
  --oc-elevation-surface-hover: {{root.oc-elevation-surface-hover}};
  --oc-elevation-popover: {{root.oc-elevation-popover}};
  --oc-elevation-modal: {{root.oc-elevation-modal}};
  --oc-shadow-surface: {{root.oc-shadow-surface}};
  --oc-shadow-popover: {{root.oc-shadow-popover}};
  --oc-shadow-modal: {{root.oc-shadow-modal}};
  --oc-shadow-surface-hover: {{root.oc-shadow-surface-hover}};
  --oc-control-height: {{root.oc-control-height}};
  --oc-control-height-compact: {{root.oc-control-height-compact}};
  --oc-control-height-large: {{root.oc-control-height-large}};
  --oc-density-gap: {{root.oc-density-gap}};
  --oc-density-inset: {{root.oc-density-inset}};
  --oc-density-header-gap: {{root.oc-density-header-gap}};
  --oc-density-row: {{root.oc-density-row}};
  --oc-space-unit: {{root.oc-space-unit}};
  --oc-space-control: {{root.oc-space-control}};
  --oc-space-content: {{root.oc-space-content}};
  --oc-space-section: {{root.oc-space-section}};
  --oc-space-page: {{root.oc-space-page}};
  /* Sans for controls and body copy; Caslon for the editorial display voice. */
  --oc-font-sans: {{root.oc-font-sans}};
  --oc-font-display: {{root.oc-font-display}};
  --oc-weight-regular: {{root.oc-weight-regular}};
  --oc-weight-medium: {{root.oc-weight-medium}};
  --oc-weight-semibold: {{root.oc-weight-semibold}}; /* Compatibility alias for existing components. */
  --oc-weight-bold: {{root.oc-weight-bold}};
  --oc-weight-title: {{root.oc-weight-title}};
  --oc-weight-display: {{root.oc-weight-display}};
  --oc-leading-heading: {{root.oc-leading-heading}};
  --oc-leading-compact: {{root.oc-leading-compact}};
  --oc-tracking-heading: {{root.oc-tracking-heading}};
  /* Tracking by size (apple-design §15): large type tightens, small type stays near 0, all-caps opens up. */
  --oc-tracking-title: {{root.oc-tracking-title}};
  --oc-tracking-section: {{root.oc-tracking-section}};
  --oc-tracking-card: {{root.oc-tracking-card}};
  --oc-tracking-small: {{root.oc-tracking-small}};
  --oc-tracking-caps: {{root.oc-tracking-caps}};
  --oc-leading-subheading: {{root.oc-leading-subheading}};
  --oc-text-section: {{root.oc-text-section}};
  --oc-text-card: {{root.oc-text-card}};
  --oc-text-modal: {{root.oc-text-modal}};
  --oc-text-small: {{root.oc-text-small}};
  --oc-text-metric: {{root.oc-text-metric}};
  --oc-text-hero: {{root.oc-text-hero}};
  --oc-text-hero-mobile: {{root.oc-text-hero-mobile}};
  --oc-text-caption: {{root.oc-text-caption}};
  --oc-text-body: {{root.oc-text-body}};
  --oc-text-title: {{root.oc-text-title}};
  --oc-text-display: {{root.oc-text-display}};
  --oc-leading-body: {{root.oc-leading-body}};
  --oc-leading-display: {{root.oc-leading-display}};
  --oc-tracking-display: {{root.oc-tracking-display}};
  --oc-size-7: {{root.oc-size-7}};
  --oc-size-8: {{root.oc-size-8}};
  --oc-size-9: {{root.oc-size-9}};
  --oc-size-10: {{root.oc-size-10}};
  --oc-size-11: {{root.oc-size-11}};
  --oc-size-12: {{root.oc-size-12}};
  /* 13px secondary text (form labels, row meta, fact lists) sits between caption and small; ~50 literals used it. */
  --oc-size-13: {{root.oc-size-13}};
  --oc-size-14: {{root.oc-size-14}};
  --oc-size-16: {{root.oc-size-16}};
  --oc-size-18: {{root.oc-size-18}};
  --oc-size-20: {{root.oc-size-20}};
  --oc-size-22: {{root.oc-size-22}};
  --oc-size-24: {{root.oc-size-24}};
  --oc-size-28: {{root.oc-size-28}};
  --oc-size-32: {{root.oc-size-32}};
  --oc-size-36: {{root.oc-size-36}};
  --oc-size-48: {{root.oc-size-48}};
  --oc-size-64: {{root.oc-size-64}};
  --oc-size-72: {{root.oc-size-72}};
  --oc-size-96: {{root.oc-size-96}};
  --oc-z-sticky: {{root.oc-z-sticky}};
  --oc-z-overlay: {{root.oc-z-overlay}};
  --oc-z-modal: {{root.oc-z-modal}};
  --oc-z-popover: {{root.oc-z-popover}};
  --oc-z-tooltip: {{root.oc-z-tooltip}};
  --oc-z-toast: {{root.oc-z-toast}};
  --oc-duration-micro: {{root.oc-duration-micro}};
  --oc-duration-ui: {{root.oc-duration-ui}};
  --oc-duration-entrance: {{root.oc-duration-entrance}};
  --oc-duration-signature: {{root.oc-duration-signature}};
  --oc-ease-out: {{root.oc-ease-out}};
  --oc-ease-ui: {{root.oc-ease-ui}};
  /* Springs (docs: .claude/skills/apple-design §4, lib/spring.ts). A critically damped spring has one shape at every
     speed, so one curve serves all durations: --oc-spring with --oc-spring-ui (response .35s) or --oc-spring-quick
     (response .24s). --oc-spring-bounce (damping .8) is only for motion a gesture threw: a flick, a drag release.
     Browsers without linear() keep the cubic fallback from the @supports block below. */
  --oc-spring: {{root.oc-spring}};
  --oc-spring-bounce: {{root.oc-spring-bounce}};
  --oc-spring-ui: {{root.oc-spring-ui}};
  --oc-spring-quick: {{root.oc-spring-quick}};
  --oc-spring-bounce-duration: {{root.oc-spring-bounce-duration}};
  --oc-press-in: {{root.oc-press-in}};
  /* Pressed feedback (styles/pressed-states.css): controls settle slightly; large cards settle less.
     Reduced motion keeps only the tone (the glass press shades in styles/navigation-glass.css). */
  --oc-press-scale: {{root.oc-press-scale}};
  --oc-press-scale-large: {{root.oc-press-scale-large}};
  --sidebar: {{root.sidebar}};
  --sidebar-foreground: {{root.sidebar-foreground}};
  --sidebar-primary: {{root.sidebar-primary}};
  --sidebar-primary-foreground: {{root.sidebar-primary-foreground}};
  --sidebar-accent: {{root.sidebar-accent}};
  --sidebar-accent-foreground: {{root.sidebar-accent-foreground}};
  --sidebar-border: {{root.sidebar-border}};
  --sidebar-ring: {{root.sidebar-ring}};
  /* Former product-only tokens (rail, surfaces, field, shell geometry). */
  --oc-rail: {{root.oc-rail}};
  --oc-rail-text: {{root.oc-rail-text}};
  --oc-rail-muted: {{root.oc-rail-muted}};
  --oc-rail-selected: {{root.oc-rail-selected}};
  --oc-rail-rule: {{root.oc-rail-rule}};
  --oc-field-muted: {{root.oc-field-muted}};
  --oc-field-rule: {{root.oc-field-rule}};
  --oc-surface-blue: {{root.oc-surface-blue}};
  --oc-surface-sage: {{root.oc-surface-sage}};
  --oc-surface-lilac: {{root.oc-surface-lilac}};
  --oc-surface-warm: {{root.oc-surface-warm}};
  --oc-shell-rail-width: {{root.oc-shell-rail-width}};
  --oc-shell-header-height: {{root.oc-shell-header-height}};
  --oc-shell-mobile-height: {{root.oc-shell-mobile-height}};
  /* Live voting tracker and result bars (outcome segments always paired with text counts). */
  --oc-vote-pass: {{root.oc-vote-pass}};
  --oc-vote-fail: {{root.oc-vote-fail}};
  --oc-vote-held: {{root.oc-vote-held}};
  --oc-vote-track: {{root.oc-vote-track}};
  --oc-vote-marker: {{root.oc-vote-marker}};
}

/* Projector theme: only the live-voting presentation sets data-theme="present" (its page wrapper; the
   focus frame bar follows it with :has, so the bar shown over the slide is dark too).
   Same semantic names, dark values, so every component keeps reading tokens. */
[data-theme="present"], .oc-focus-frame:has(.oc-present-surface) .oc-focus-bar {
  color-scheme: dark;
  --background: {{present.background}};
  --foreground: {{present.foreground}};
  --card: {{present.card}};
  --card-foreground: {{present.card-foreground}};
  --popover: {{present.popover}};
  --popover-foreground: {{present.popover-foreground}};
  --primary: {{present.primary}};
  --primary-foreground: {{present.primary-foreground}};
  --secondary: {{present.secondary}};
  --secondary-foreground: {{present.secondary-foreground}};
  --muted: {{present.muted}};
  --muted-foreground: {{present.muted-foreground}};
  --accent: {{present.accent}};
  --accent-foreground: {{present.accent-foreground}};
  --brand-subtle: {{present.brand-subtle}};
  --brand-ink: {{present.brand-ink}};
  --destructive: {{present.destructive}};
  --destructive-foreground: {{present.destructive-foreground}};
  --error-subtle: {{present.error-subtle}};
  --success: {{present.success}};
  --success-subtle: {{present.success-subtle}};
  --warning: {{present.warning}};
  --warning-subtle: {{present.warning-subtle}};
  --info: {{present.info}};
  --info-subtle: {{present.info-subtle}};
  --interview: {{present.interview}};
  --interview-subtle: {{present.interview-subtle}};
  --border: {{present.border}};
  --input: {{present.input}};
  --ring: {{present.ring}};
  --oc-content-surface: {{present.oc-content-surface}};
  --oc-content-soft: {{present.oc-content-soft}};
  --oc-content-soft-blue: {{present.oc-content-soft-blue}};
  --oc-content-edge: {{present.oc-content-edge}};
  /* The live voting slide stays solid: no glass highlight on the projector. */
  --oc-elevation-surface: {{present.oc-elevation-surface}};
  /* Aliases resolve where they are declared, so redeclare them in this scope to pick up the solid level. */
  --oc-content-shadow: {{present.oc-content-shadow}};  --oc-vote-pass: {{present.oc-vote-pass}};
  --oc-vote-fail: {{present.oc-vote-fail}};
  --oc-vote-held: {{present.oc-vote-held}};
  --oc-vote-track: {{present.oc-vote-track}};
  --oc-vote-marker: {{present.oc-vote-marker}};
}

/* Light projector: the live-voting room's theme switch puts the cream/navy canvas back inside the dark
   projector wrapper. Every token the projector theme overrides is restated with its :root value
   (tests/voting-room-theme.test.cjs keeps the two in step); the slide stays solid, never glass. */
[data-theme="present-light"], .oc-focus-frame:has([data-theme="present-light"]) .oc-focus-bar {
  color-scheme: light;
  --background: {{presentLight.background}};
  --foreground: {{presentLight.foreground}};
  --card: {{presentLight.card}};
  --card-foreground: {{presentLight.card-foreground}};
  --popover: {{presentLight.popover}};
  --popover-foreground: {{presentLight.popover-foreground}};
  --primary: {{presentLight.primary}};
  --primary-foreground: {{presentLight.primary-foreground}};
  --secondary: {{presentLight.secondary}};
  --secondary-foreground: {{presentLight.secondary-foreground}};
  --muted: {{presentLight.muted}};
  --muted-foreground: {{presentLight.muted-foreground}};
  --accent: {{presentLight.accent}};
  --accent-foreground: {{presentLight.accent-foreground}};
  --brand-subtle: {{presentLight.brand-subtle}};
  --brand-ink: {{presentLight.brand-ink}};
  --destructive: {{presentLight.destructive}};
  --destructive-foreground: {{presentLight.destructive-foreground}};
  --error-subtle: {{presentLight.error-subtle}};
  --success: {{presentLight.success}};
  --success-subtle: {{presentLight.success-subtle}};
  --warning: {{presentLight.warning}};
  --warning-subtle: {{presentLight.warning-subtle}};
  --info: {{presentLight.info}};
  --info-subtle: {{presentLight.info-subtle}};
  --interview: {{presentLight.interview}};
  --interview-subtle: {{presentLight.interview-subtle}};
  --border: {{presentLight.border}};
  --input: {{presentLight.input}};
  --ring: {{presentLight.ring}};
  --oc-content-surface: {{presentLight.oc-content-surface}};
  --oc-content-soft: {{presentLight.oc-content-soft}};
  --oc-content-soft-blue: {{presentLight.oc-content-soft-blue}};
  --oc-content-edge: {{presentLight.oc-content-edge}};
  --oc-vote-pass: {{presentLight.oc-vote-pass}};
  --oc-vote-fail: {{presentLight.oc-vote-fail}};
  --oc-vote-held: {{presentLight.oc-vote-held}};
  --oc-vote-track: {{presentLight.oc-vote-track}};
  --oc-vote-marker: {{presentLight.oc-vote-marker}};
}

/* Another school's colours override only the school layer. Set data-school on <html>: the semantic tokens
   are declared on :root and resolve there, so the attribute on a lower element would change nothing. For example:
   [data-school="example"] {
     --school-primary: #...;      text and primary actions; >= 4.5:1 on the light canvas
     --school-accent: #...;       accents, large text and UI parts; >= 3:1
     --school-accent-text: #...;  small accent text; >= 4.5:1 on every light surface
     --school-ring: #...;         >= 3:1 on canvas, cards, --school-primary and the projector theme
   }
   tests/school-theme-tokens.test.cjs checks these ratios for every school defined here. */

@supports (transition-timing-function: linear(0, 1)) {
  :root {
    --oc-spring: {{supportsSpring.oc-spring}};
    --oc-spring-bounce: {{supportsSpring.oc-spring-bounce}};
  }
}
