DATABASE_URL="postgresql://..."
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-publishable-key"
# Microsoft OAuth is disabled unless explicitly set to true. Rebuild after changing.
NEXT_PUBLIC_ENABLE_MICROSOFT_AUTH=false

# Optional "Check Outlook" in the specific-dates availability editor. Read-only
# (Calendars.ReadBasic), one week at a time; tokens are used once and never stored.
# Needs a Microsoft Entra app registration with redirect URI
# <site>/api/calendar/outlook/callback. Rebuild after changing the NEXT_PUBLIC flag.
NEXT_PUBLIC_OUTLOOK_CALENDAR_ENABLED=false
MICROSOFT_CALENDAR_CLIENT_ID=""
MICROSOFT_CALENDAR_CLIENT_SECRET=""
# Required: the university's Entra tenant ID, so only its accounts can be connected.
MICROSOFT_CALENDAR_TENANT=""

# Server only. Never use NEXT_PUBLIC_ for a secret key.
SUPABASE_SECRET_KEY=""
# Temporary opt-in while email delivery is unavailable.

# Application invitation emails: reuse the provider configured for Supabase Auth SMTP.
# These values are server-only. Leave unset to disable sending with a clear UI error.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL=""
OUTCLASS_SITE_URL="https://www.out-class.net"
# Optional protected delivery worker endpoint; configure a random server-only secret.
CRON_SECRET=""

# Installable app: set to "off" to stop registering the service worker and unregister it in
# every browser that loads a page (docs/service-worker.md). Leave unset to keep it on.
OUTCLASS_SERVICE_WORKER=""
# Optional two-step sign-in (TOTP) for every account. Set to 1 only after enabling TOTP MFA in
# Supabase Auth. Off: the Settings section is hidden and sign-in is unchanged.
OUTCLASS_USER_MFA=""

# Optional Web Push for the installed app (docs/service-worker.md). Off unless all three are set.
# Generate with `npx web-push generate-vapid-keys`; the private key is server-only. The public key
# reaches the browser through a server action, so no NEXT_PUBLIC_ copy is needed.
# VAPID_SUBJECT is a mailto: or https: contact for push services.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT=""

# Optional communication emails stay disabled until deployment approval.
# Use a verified Resend sender. The queue worker uses POST /api/internal/notification-delivery.
COMMUNICATIONS_EMAIL_ENABLED=false
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""
# Business mailing address shown in every email footer and on /legal (one line, e.g.
# "123 Main St, Charlottesville, VA 22903"). Unset: email footers omit the line (one warning)
# and /legal shows a placeholder. Regenerate supabase/templates after setting it
# (node scripts/email-audit.cjs build) so Auth emails carry it too.
OUTCLASS_POSTAL_ADDRESS=""
# Server-only, at least 32 random characters. Signs one-click unsubscribe links
# (List-Unsubscribe) in digest and announcement emails; each link can only turn OFF that
# user's optional email (never decision or interview email). Unset: the header points to email preferences without one-click.
# Rotating it invalidates links in emails already sent; to keep old links working for a
# grace period, put the old value in EMAIL_UNSUBSCRIBE_SECRET_PREVIOUS (verify only), then
# remove it (docs/legal-review-checklist.md).
EMAIL_UNSUBSCRIBE_SECRET=""
EMAIL_UNSUBSCRIBE_SECRET_PREVIOUS=""

# Optional Cloudflare Turnstile bot check (docs/turnstile.md). Off unless BOTH keys are set
# at build; then the widget runs on signup, sign-in, code resend, password recovery, student
# claim, Admin sign-in and school requests. Rebuild after changing either. OutClass verifies
# signup, password recovery, school requests and student claims with the secret key.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
# Server-only. Set to 1 in the same window as enabling Supabase Auth's Bot and Abuse
# Protection (same secret): signup and recovery then forward tokens to Supabase instead.
TURNSTILE_AUTH_ENFORCED_BY_SUPABASE=""

# Optional Sentry error reports (errors only; request bodies, cookies, headers,
# query strings, console output and typed input are stripped before sending).
# Off unless a DSN is set. NEXT_PUBLIC_SENTRY_DSN enables browser and server reports
# and is fixed at build time; SENTRY_DSN alone enables server reports only.
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_DSN=""
