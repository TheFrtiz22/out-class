DATABASE_URL="postgresql://..."
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-publishable-key"
# Microsoft OAuth is disabled unless explicitly set to true. Rebuild after changing.
NEXT_PUBLIC_ENABLE_MICROSOFT_AUTH=false

# Server only. Never use NEXT_PUBLIC_ for a secret key.
SUPABASE_SECRET_KEY=""
# Temporary opt-in while email delivery is unavailable.

# Application invitation emails: reuse the provider configured for Supabase Auth SMTP.
# These values are server-only. Leave unset to disable sending with a clear UI error.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL=""
OUTCLASS_SITE_URL="https://www.out-class.net"
# Optional protected delivery worker endpoint; configure a random server-only secret.
CRON_SECRET=""
