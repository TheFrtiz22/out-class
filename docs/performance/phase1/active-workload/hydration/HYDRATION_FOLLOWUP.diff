+++ b/scripts/phase1-workload-build.cjs
@@ -0,0 +1,60 @@
+// Start one of two fixed local builds for the active-room comparison.
+// Never fetches environment values or changes a hosted service.
+const fs = require('node:fs'), path = require('node:path'), os = require('node:os');
+const assert = require('node:assert/strict');
+const { spawn, spawnSync, execFileSync } = require('node:child_process');
+const { randomUUID } = require('node:crypto');
+const { readConfig } = require('../tests/helpers/onboarding-e2e.cjs');
+const root = path.join(os.tmpdir(), 'outclass-onboarding-e2e');
+const repo = path.resolve(__dirname, '..'), configFile = path.join(root, 'config.json');
+const config = readConfig(configFile), s = config.status;
+const reference = '3017e01d5b55bc8fb38d4f8fbec4906dd93bf619';
+const target = process.argv[2];
+assert.ok(['reference', 'current'].includes(target) && process.argv.length === 3);
+const referenceRoot = path.join(root, 'active-workload-audit-reference');
+const applicationPaths = ['app', 'actions', 'components', 'contexts', 'hooks', 'lib', 'utils', 'public', 'styles', 'prisma', 'middleware.ts', 'next.config.mjs', 'package.json', 'pnpm-lock.yaml'];
+assert.equal(execFileSync('git', ['diff', 'HEAD', '--name-only', '--', ...applicationPaths], { cwd: repo, encoding: 'utf8' }).trim(), '', 'Current application changes must be built and identified before comparison');
+assert.equal(execFileSync('git', ['ls-files', '--others', '--exclude-standard', '--', ...applicationPaths], { cwd: repo, encoding: 'utf8' }).trim(), '');
+
+(async () => {
+  const pid = Number(fs.readFileSync(path.join(root, 'server.pid'), 'utf8'));
+  assert.equal(execFileSync('lsof', ['-tiTCP:3107', '-sTCP:LISTEN'], { encoding: 'utf8' }).trim(), String(pid));
+  const cwd = execFileSync('lsof', ['-a', '-p', String(pid), '-d', 'cwd', '-Fn'], { encoding: 'utf8' }).split('\n').find(line => line.startsWith('n'))?.slice(1);
+  assert.ok([repo, referenceRoot].filter(p=>fs.existsSync(p)).map(p=>fs.realpathSync(p)).includes(fs.realpathSync(cwd)), 'Only the reserved app may be replaced');
+  process.kill(pid, 'SIGTERM');
+  for (let n = 0; n < 100; n++) {
+    if (spawnSync('lsof', ['-tiTCP:3107', '-sTCP:LISTEN'], { stdio: 'ignore' }).status !== 0) break;
+    await new Promise(r => setTimeout(r, 50));
+    if (n === 99) throw Error('Reserved app did not stop');
+  }
+  if (target === 'reference' && !fs.existsSync(referenceRoot)) {
+    fs.mkdirSync(referenceRoot);
+    const archive = execFileSync('git', ['archive', '--format=tar', reference], { cwd: repo, maxBuffer: 64 * 1024 * 1024 });
+    assert.equal(spawnSync('tar', ['-xf', '-', '-C', referenceRoot], { input: archive }).status, 0);
+    fs.symlinkSync(path.join(repo, 'node_modules'), path.join(referenceRoot, 'node_modules'), 'dir');
+    fs.writeFileSync(path.join(referenceRoot, '.outclass-audit-reference'), reference);
+  }
+  const source = target === 'reference' ? referenceRoot : repo;
+  if (target === 'reference') assert.equal(fs.readFileSync(path.join(source, '.outclass-audit-reference'), 'utf8'), reference);
+  const pool = new URL(s.DB_URL); pool.searchParams.set('connection_limit', '8');
+  const env = { ...process.env, NEXT_PUBLIC_ENABLE_MICROSOFT_AUTH: 'false', DATABASE_URL: pool.href, POSTGRES_PRISMA_URL: pool.href, POSTGRES_URL: pool.href, POSTGRES_URL_NON_POOLING: pool.href, NEXT_PUBLIC_SUPABASE_URL: s.API_URL, NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY: s.PUBLISHABLE_KEY, NEXT_PUBLIC_SUPABASE_ANON_KEY: s.ANON_KEY, SUPABASE_SECRET_KEY: s.SECRET_KEY, SUPABASE_SERVICE_ROLE_KEY: s.SERVICE_ROLE_KEY, OUTCLASS_PUBLISH_BUILD: '1', OUTCLASS_SITE_URL: config.appUrl, OUTCLASS_PLATFORM_ADMIN_IDS: config.admin.id, SMTP_HOST: '127.0.0.1', SMTP_PORT: '55325', SMTP_USER: 'local-test', SMTP_PASSWORD: 'local-test', SMTP_FROM_EMAIL: 'outclass@virginia.edu', CRON_SECRET: randomUUID(), NODE_EXTRA_CA_CERTS: path.join(root, 'mailpit-cert.pem'), COMMUNICATIONS_EMAIL_ENABLED: 'false', RESEND_API_KEY: '', RESEND_FROM_EMAIL: '' };
+  const buildDir = path.join(source, '.next-publish');
+  if (target === 'reference' && !fs.existsSync(path.join(buildDir, 'BUILD_ID'))) {
+    const fd = fs.openSync(path.join(root, 'active-reference-build.log'), 'w');
+    const result = spawnSync(process.execPath, [path.join(repo, 'node_modules/next/dist/bin/next'), 'build'], { cwd: source, env, stdio: ['ignore', fd, fd] });
+    fs.closeSync(fd); assert.equal(result.status, 0, 'Inspect the reserved reference build log');
+  }
+  assert.ok(fs.existsSync(path.join(buildDir, 'BUILD_ID')));
+  const log = fs.openSync(path.join(root, 'active-' + target + '-server.log'), 'a');
+  const app = spawn(process.execPath, [path.join(repo, 'node_modules/next/dist/bin/next'), 'start', '-p', '3107', '-H', '127.0.0.1'], { cwd: source, env, detached: true, stdio: ['ignore', log, log] });
+  fs.closeSync(log); app.unref();
+  fs.writeFileSync(path.join(root, 'server.pid'), String(app.pid));
+  config.buildDir = buildDir;
+  config.activeWorkload = { target, sourceCommit: target === 'reference' ? reference : execFileSync('git', ['rev-parse', 'HEAD'], { cwd: repo, encoding: 'utf8' }).trim(), applicationSourcesModified: false, poolLimitPerPrismaClient: 8, buildId: fs.readFileSync(path.join(buildDir, 'BUILD_ID'), 'utf8').trim() };
+  fs.writeFileSync(configFile, JSON.stringify(config), { mode: 0o600 });
+  for (let n = 0; n < 100; n++) {
+    try { if ((await fetch(config.appUrl)).ok) { console.log(JSON.stringify(config.activeWorkload)); return; } } catch {}
+    await new Promise(r => setTimeout(r, 200));
+  }
+  throw Error('Reserved workload app did not start');
+})().catch(error => { console.error(error.name + ': ' + String(error.message).split('\n')[0]); process.exitCode = 1; });
diff --git a/scripts/summarize-active-navigation.cjs b/scripts/summarize-active-navigation.cjs
new file mode 100644
index 0000000..ef54f77
--- /dev/null
+++ b/scripts/summarize-active-navigation.cjs
@@ -0,0 +1,32 @@
+// Aggregate sanitized active-room samples, keeping participant and wave counts explicit.
+const fs = require('node:fs'), path = require('node:path');
+const { distribution } = require('./navigation-audit.cjs');
+const root = path.resolve('docs/performance/phase1/active-workload');
+const names = { getAssignedInterviewRooms: 'assignedRooms', getInterviewWorkspace: 'interviewWorkspace', getInterviewRounds: 'interviewRounds' };
+const kind = r => r.route.includes('?kind=') ? r.route.split('?kind=')[1] : names[r.route.split(':').at(-1)];
+const phases = r => Object.fromEntries([...String(r.serverTiming || '').matchAll(/([a-z_]+);dur=([\d.]+)/g)].map(m => [m[1], Number(m[2])]));
+const summary = { observationUnit: 'participant navigation, clustered in simultaneous waves', poolSamplingIntervalMs: 50, groups: [], limitations: ['Local warm server/database; cold means a fresh browser context and unvisited destination.', 'One and four users; not a production capacity or sustained-load test.', 'Each reviewer has the same 24 non-overlapping bookings in three owner-attested rooms; published slot-panel versions are not represented.', 'An 8-connection limit applies per Prisma client, not globally to every server process or service.', 'Database sampler observes same-role backends except itself; 50 ms sampling can miss short waits and is not a Prisma queue measurement.', 'DOM readiness plus two animation frames is a paint proxy; four-user observations share browser/CPU and wave.', 'Reference cohorts run before current cohorts; not a randomized crossover.'] };
+summary.limitations.push('Browser error counts cover each page lifetime, including initial page load and warm-up; they are not localized to the measured destination click.', 'The raw membersPerClub=61 describes the base fixture; three verified reviewers increase the active club to 64 members.', 'The initial incomplete four-user reference run and two smoke runs are preserved outside the primary groups.');
+for (const stage of ['reference', 'current']) for (const clients of [1, 4]) {
+  const file = path.join(root, stage + '-' + clients, 'browser-samples.json');
+  if (!fs.existsSync(file)) continue;
+  const data = JSON.parse(fs.readFileSync(file));
+  for (const condition of ['cold', 'warm']) {
+    const samples = data.samples.filter(s => s.condition === condition), requests = samples.flatMap(s => s.requests);
+    const critical = samples.map(s => {
+      const found = new Map();
+      for (const r of s.requests) { const key = kind(r); if (['assignedRooms', 'interviewWorkspace', 'interviewRounds'].includes(key) && !found.has(key)) found.set(key, r); }
+      return [...found.values()];
+    });
+    const reads = critical.flat(), phaseNames = [...new Set(reads.flatMap(r => Object.keys(phases(r))))];
+    const complete = samples.filter(s => s.requests.every(r => r.type === 'eventsource' || r.encodedBodyBytes !== null));
+    const pool = data.poolSamples.filter(s => s.condition === condition);
+    const visibleReads = Object.fromEntries(['assignedRooms', 'interviewWorkspace', 'interviewRounds'].map(name => {
+      const rows = reads.filter(r => kind(r) === name);
+      return [name, { requests: rows.length, durationMs: distribution(rows.map(r => r.endMs - r.startMs)), ttfbMs: distribution(rows.map(r => r.ttfbMs)), serverPhasesMs: Object.fromEntries(phaseNames.map(phase => [phase, distribution(rows.map(r => phases(r)[phase]))])) }];
+    }));
+    summary.groups.push({ stage, clients, condition, build: data.build, waves: new Set(samples.map(s => s.wave)).size, samples: samples.length, failures: data.failures.filter(f => f.condition === condition), ...Object.fromEntries(['meaningfulMs', 'interactiveMs', 'requestCount', 'networkCompleteMs', 'scriptMs', 'taskMs'].map(metric => [metric, distribution(samples.map(s => s[metric]))])), observedBodyBytesLowerBound: distribution(samples.map(s => s.encodedBodyBytes)), completePayloadSamples: complete.length, completePayloadBytes: distribution(complete.map(s => s.encodedBodyBytes)), httpErrors: requests.filter(r => r.status >= 400).length, transportFailures: requests.filter(r => r.failed).length, post200Aborts: requests.filter(r => r.failed && r.status === 200 && r.failureReason === 'net::ERR_ABORTED').length, failureReasons: Object.fromEntries([...new Set(requests.filter(r => r.failed).map(r => r.failureReason))].map(reason => [reason, requests.filter(r => r.failed && r.failureReason === reason).length])), pageErrors: samples.reduce((n, s) => n + (s.pageErrorCount || 0), 0), visibleReadBarrierMs: distribution(critical.filter(rows => rows.length === 3).map(rows => Math.max(...rows.map(r => r.endMs)) - Math.min(...rows.map(r => r.startMs)))), visibleReadTtfbMs: distribution(reads.map(r => r.ttfbMs)), visibleReads, serverPhasesMs: Object.fromEntries(phaseNames.map(phase => [phase, distribution(reads.map(r => phases(r)[phase]))])), pool: { samples: pool.length, connections: distribution(pool.map(s => s.connections)), active: distribution(pool.map(s => s.active)), idleInTransaction: distribution(pool.map(s => s.idle_in_transaction)), lockWaiting: distribution(pool.map(s => s.lock_waiting)) } });
+  }
+}
+fs.writeFileSync(path.join(root, 'COMPARISON.json'), JSON.stringify(summary, null, 2) + '\n');
+for (const g of summary.groups) console.log(`${g.stage} ${g.clients} clients ${g.condition}: ${g.meaningfulMs.p50}/${g.meaningfulMs.p95} ms, ${g.requestCount.p50} requests, ${g.httpErrors} HTTP errors, ${g.post200Aborts} post-200 aborts, ${g.pageErrors} browser errors`);
diff --git a/tests/active-interview-navigation-e2e.test.cjs b/tests/active-interview-navigation-e2e.test.cjs
new file mode 100644
index 0000000..6f1cf28
--- /dev/null
+++ b/tests/active-interview-navigation-e2e.test.cjs
@@ -0,0 +1,49 @@
+// Opt-in real HTTP/Auth/PostgreSQL checks for the reserved active navigation fixture.
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('node:fs'), path = require('node:path');
+const { PrismaClient } = require('@prisma/client');
+const { Actor, readConfig } = require('./helpers/onboarding-e2e.cjs');
+const { load } = require('./helpers/voting-harness.cjs');
+const { decodeWorkspaceData } = load('lib/workspace-wire.ts');
+const configFile = process.env.OUTCLASS_ONBOARDING_E2E_CONFIG;
+
+test('active Interview Rooms: distinct reviewers, concurrent reads and immediate assignment revocation', { skip: !configFile, timeout: 60000 }, async t => {
+  const config = readConfig(configFile);
+  const fixture = JSON.parse(fs.readFileSync(path.join(path.dirname(configFile), 'active-interview-fixture.json')));
+  const db = new PrismaClient({ datasourceUrl: config.status.DB_URL });
+  t.after(() => db.$disconnect());
+  const actors = [];
+  for (const credentials of fixture.credentials) {
+    const actor = new Actor(config); await actor.signIn(credentials.email, credentials.password); actors.push(actor);
+  }
+  assert.equal(new Set(actors.map(actor => actor.user.id)).size, 4);
+  const read = async (actor, kind) => {
+    const response = await actor.request('/api/workspace?' + new URLSearchParams({ kind, args: JSON.stringify([fixture.clubId]) }));
+    assert.equal(response.status, 200, kind);
+    assert.equal(response.headers.get('cache-control'), 'private, no-store');
+    assert.match(response.headers.get('vary'), /(?:^|,\s*)Cookie(?:,|$)/);
+    return { data: decodeWorkspaceData(await response.json()), trace: response.headers.get('x-outclass-trace-id') };
+  };
+  await t.test('four separately verified accounts receive all 24 authorized bookings and distinct request traces', async () => {
+    const results = await Promise.all(actors.map(async actor => {
+      const [assigned, workspace, rounds] = await Promise.all(['assignedRooms', 'interviewWorkspace', 'interviewRounds'].map(kind => read(actor, kind)));
+      assert.equal(assigned.data.length, 24); assert.ok(assigned.data.every(row => row.canOpen && row.applicationId));
+      assert.equal(workspace.data.applications.length, 24); assert.equal(rounds.data.status, 'ready');
+      return [assigned.trace, workspace.trace, rounds.trace];
+    }));
+    const traces = results.flat(); assert.ok(traces.every(trace => /^[a-f0-9-]{36}$/.test(trace))); assert.equal(new Set(traces).size, 12);
+  });
+  await t.test('revoking one booking grant removes that candidate on the next requests and preserves other reviewers', async () => {
+    const member = await db.clubMember.findUniqueOrThrow({ where: { userId_clubId: { userId: actors[1].user.id, clubId: fixture.clubId } } });
+    const grant = await db.interviewPanelAssignment.findFirstOrThrow({ where: { memberId: member.id, revokedAt: null, bookingManaged: true } });
+    try {
+      await db.interviewPanelAssignment.update({ where: { id: grant.id }, data: { revokedAt: new Date() } });
+      const assigned = await read(actors[1], 'assignedRooms'), workspace = await read(actors[1], 'interviewWorkspace');
+      assert.equal(assigned.data.length, 23); assert.ok(assigned.data.every(row => row.applicationId !== grant.applicationId));
+      assert.equal(workspace.data.applications.length, 23); assert.ok(workspace.data.applications.every(row => row.id !== grant.applicationId));
+      assert.equal((await read(actors[2], 'assignedRooms')).data.length, 24);
+    } finally { await db.interviewPanelAssignment.update({ where: { id: grant.id }, data: { revokedAt: grant.revokedAt } }); }
+    assert.equal((await read(actors[1], 'assignedRooms')).data.length, 24);
+  });
+});
diff --git a/tests/hydration-diagnostics-browser.test.cjs b/tests/hydration-diagnostics-browser.test.cjs
new file mode 100644
index 0000000..a699fa4
--- /dev/null
+++ b/tests/hydration-diagnostics-browser.test.cjs
@@ -0,0 +1,44 @@
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const http = require('node:http');
+const { chromium } = require('playwright');
+const { bundle } = require('./helpers/browser-bundle.cjs');
+const { installBrowserObservers } = require('../scripts/navigation-audit.cjs');
+
+test('optional hydration diagnostics capture the component, preserve React reporting and omit private values', async () => {
+  const code = bundle(`import React from 'react';import {hydrateRoot} from 'react-dom/client';function HydrationCase(){return <p className="oc-hydration-fixture">Client snapshot</p>}window.originalCalls=0;hydrateRoot(document.getElementById('root'),<HydrationCase/>,{onRecoverableError(){window.originalCalls++}});`);
+  const server = http.createServer((req, res) => {
+    res.setHeader('Content-Type', req.url === '/fixture.js' ? 'application/javascript' : 'text/html');
+    res.end(req.url === '/fixture.js' ? code : '<div id="root"><p class="oc-hydration-fixture">Server snapshot</p></div><script src="/fixture.js"></script>');
+  });
+  await new Promise(resolve => server.listen(0, '127.0.0.1', resolve));
+  const browser = await chromium.launch({ headless: true });
+  try {
+    for (const enabled of [false, true]) {
+      const context = await browser.newContext();
+      await context.addInitScript(installBrowserObservers, { diagnoseHydration: enabled });
+      const page = await context.newPage();
+      await page.goto('http://127.0.0.1:' + server.address().port);
+      await page.waitForFunction(() => window.originalCalls === 1);
+      const diagnostics = await page.evaluate(() => window.__navAudit.hydration);
+      assert.equal(diagnostics.length, enabled ? 1 : 0);
+      if (enabled) {
+        assert.equal(diagnostics[0].code, 418); assert.equal(diagnostics[0].phase, 'initial');
+        assert.match(diagnostics[0].stack, /HydrationCase/);
+        assert.ok(diagnostics[0].components.some(c => c.classes.includes('oc-hydration-fixture')));
+        const redacted = await page.evaluate(() => {
+          function Fixture() { return 'oc-fixture'; }
+          let original = false;
+          const error = Error('Minified React error #418; raw-secret');
+          const info = { componentStack: '\n at Fixture (https://example.test/fixture.js?token=raw-secret)' };
+          const root = { current: { type: Fixture, memoizedProps: { token: 'raw-secret' } }, onRecoverableError(e, i) { original = e === error && i === info; } };
+          window.__REACT_DEVTOOLS_GLOBAL_HOOK__.onCommitFiberRoot(1, root);
+          root.onRecoverableError(error, info);
+          return { original, record: window.__navAudit.hydration.at(-1) };
+        });
+        assert.equal(redacted.original, true); assert.equal(JSON.stringify(redacted.record).includes('raw-secret'), false);
+      }
+      await context.close();
+    }
+  } finally { await browser.close(); server.closeAllConnections(); await new Promise(resolve => server.close(resolve)); }
+});
diff --git a/tests/route-content-hydration-browser.test.cjs b/tests/route-content-hydration-browser.test.cjs
new file mode 100644
index 0000000..8274899
--- /dev/null
+++ b/tests/route-content-hydration-browser.test.cjs
@@ -0,0 +1,53 @@
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const http = require('node:http');
+const { chromium } = require('playwright');
+const { bundle } = require('./helpers/browser-bundle.cjs');
+
+test('streamed route children hydrate without replacing server content when their chunk resolves during a replay', async () => {
+  const entry = `
+    import React, {lazy, startTransition, useEffect} from 'react';
+    import {hydrateRoot} from 'react-dom/client';
+    import {RouteContent} from '@/components/route-content';
+    const chunk = {status:'pending', then(done) {
+      queueMicrotask(() => {chunk.status='fulfilled'; chunk.value={default:<section data-route-body>Ready</section>}; done(chunk.value)});
+    }};
+    const streamed = lazy(() => chunk);
+    function App() {
+      useEffect(() => {window.hydrated=true}, []);
+      return location.pathname.endsWith('/control') ? <div className="oc-route-content">{streamed}</div> : <RouteContent>{streamed}</RouteContent>;
+    }
+    window.originalBody = document.querySelector('[data-route-body]'); window.errors=[];
+    startTransition(() => hydrateRoot(document.getElementById('root'), <App/>, {onRecoverableError(e){window.errors.push(e.message)}}));
+  `;
+  const code = { react: bundle(entry), next: bundle(entry, {
+    react: "module.exports=require('next/dist/compiled/react')",
+    'react/jsx-runtime': "module.exports=require('next/dist/compiled/react/jsx-runtime')",
+    'react-dom/client': "module.exports=require('next/dist/compiled/react-dom/client')",
+  }) };
+  const server = http.createServer((req, res) => {
+    const runtime = req.url.split('/')[1].replace('.js', '');
+    res.setHeader('Content-Type', req.url.endsWith('.js') ? 'application/javascript' : 'text/html');
+    res.end(req.url.endsWith('.js') ? code[runtime] : '<div id="root"><div class="oc-route-content"><section data-route-body>Ready</section></div></div><script src="/' + runtime + '.js"></script>');
+  });
+  await new Promise(resolve => server.listen(0, '127.0.0.1', resolve));
+  const browser = await chromium.launch({ headless: true });
+  try {
+    for (const runtime of ['react', 'next']) for (const route of ['control', 'guarded']) {
+      const page = await browser.newPage();
+      try {
+        await page.goto('http://127.0.0.1:' + server.address().port + '/' + runtime + '/' + route);
+        await page.waitForFunction(() => window.hydrated);
+        const result = await page.evaluate(() => ({errors:window.errors, retained:window.originalBody === document.querySelector('[data-route-body]'), wrappers:document.querySelectorAll('.oc-route-content').length}));
+        assert.equal(result.wrappers, 1);
+        if (route === 'control') {
+          assert.ok(result.errors.some(error => error.includes('#418')), 'Control must exercise the installed React hydration replay bug');
+          assert.equal(result.retained, false);
+        } else {
+          assert.deepEqual(result.errors, []);
+          assert.equal(result.retained, true, 'Hydration must preserve the original server-rendered node');
+        }
+      } finally { await page.close(); }
+    }
+  } finally { await browser.close(); server.closeAllConnections(); await new Promise(resolve => server.close(resolve)); }
+});
