+const bundledClubLogos: Readonly<Record<string, string>> = {
+  "vvf": "/logos/vvf.webp", "mii": "/logos/mii.webp",
+  "180-degrees": "/logos/180-degrees.png", "180-degrees-globe": "/logos/180-degrees-globe.png",
