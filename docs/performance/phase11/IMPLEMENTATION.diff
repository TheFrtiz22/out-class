+            const status = run('scripts/navigation-audit.cjs', ['--phase2', '--deferred-screens', '--cold-warm', '--record-failures', '--source-diagnostics', '--font-diagnostics', '--constrained-network', '--samples=' + n, '--out=' + path.join(out, directory)], 'phase11-feature-study.log');
+            const data = JSON.parse(fs.readFileSync(path.join(out, directory, 'browser-samples.json')));
