+  const out = path.join(local.repo, 'docs/performance/phase11', profile);
+  assert.ok(!fs.existsSync(out)); fs.mkdirSync(out);
+  const toolNames = ['navigation-phase11-study.cjs', 'navigation-phase11-local.cjs', 'navigation-audit.cjs', 'navigation-phase11-interactions.cjs', 'navigation-phase11-constrained-interactions.cjs', 'navigation-phase11-concurrency.cjs'];
