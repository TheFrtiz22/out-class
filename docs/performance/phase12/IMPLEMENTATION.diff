+async function main() {
+  const profile = process.argv.find(a => a.startsWith('--profile='))?.slice(10);
+  assert.ok(['local', 'constrained'].includes(profile));
+  const out = path.join(local.repo, 'docs/performance/phase12', profile);
+  assert.ok(!fs.existsSync(out)); fs.mkdirSync(out);
+  const toolNames = ['navigation-phase12-study.cjs', 'navigation-phase12-local.cjs', 'navigation-audit.cjs', 'navigation-phase12-interactions.cjs', 'navigation-phase12-constrained-interactions.cjs', 'navigation-phase12-concurrency.cjs'];
+  const protocol = { startedAt: new Date().toISOString(), profile, cohorts: [1000, 5000], blocks: ['BA', 'AB'], buildIds: {}, planSha256: hash(path.join(local.repo, 'docs/performance/phase12/PLAN.json')), tools: Object.fromEntries(toolNames.map(f => [f, hash(path.join(local.repo, 'scripts', f))])), completed: [], interactions: [], concurrency: [], features: [], failures: [], complete: false };
