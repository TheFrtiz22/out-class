diff --git a/hooks/use-pipeline-applicant.ts b/hooks/use-pipeline-applicant.ts
new file mode 100644
index 0000000..aa5aabb
--- /dev/null
+++ b/hooks/use-pipeline-applicant.ts
@@ -0,0 +1,27 @@
+"use client"
+
+import { useEffect, useMemo, useState } from "react"
+import { useAuth } from "@/contexts/auth-context"
+import { useDemoMode } from "@/contexts/demo-context"
+import { getClubPipeline } from "@/lib/workspace-api"
+
+type Pipeline = Awaited<ReturnType<typeof getClubPipeline>>
+
+/** A fresh, single-applicant read per opening; late or previous-authority results stay hidden. */
+export function usePipelineApplicant(clubId: string, applicationId: string | null, revision: number) {
+  const { user, readAuthority, isImpersonating } = useAuth()
+  const demo = useDemoMode()
+  const [retry, setRetry] = useState(0)
+  const owner = useMemo(() => ({ clubId, applicationId, revision, retry, user, readAuthority, isImpersonating, demoReady: demo.ready, demoEnabled: demo.isDemoEnabled }), [clubId, applicationId, revision, retry, user, readAuthority, isImpersonating, demo.ready, demo.isDemoEnabled])
+  const [result, setResult] = useState<{ owner: object; pipeline: Pipeline | null; error: boolean } | null>(null)
+  useEffect(() => {
+    if (!applicationId || !demo.ready) return
+    let current = true
+    getClubPipeline(clubId, { applicationId }).then(data => {
+      if (current) setResult({ owner, pipeline: data, error: !data.applications.some(app => app.id === applicationId) })
+    }).catch(() => { if (current) setResult({ owner, pipeline: null, error: true }) })
+    return () => { current = false }
+  }, [owner, clubId, applicationId, demo.ready])
+  const current = result?.owner === owner ? result : null
+  return { pipeline: current?.pipeline ?? null, application: current?.pipeline?.applications.find(app => app.id === applicationId) ?? null, error: current?.error ?? false, retry: () => setRetry(value => value + 1) }
+}
diff --git a/lib/applicant-pagination.ts b/lib/applicant-pagination.ts
new file mode 100644
index 0000000..0734bdf
--- /dev/null
+++ b/lib/applicant-pagination.ts
@@ -0,0 +1,9 @@
+export const APPLICANT_PAGE_SIZE = 100
+
+/** Display boundary only: callers retain the complete filtered selection. */
+export function applicantPage<T>(applicants: readonly T[], requested: number) {
+  const count = Math.max(1, Math.ceil(applicants.length / APPLICANT_PAGE_SIZE))
+  const page = Math.max(0, Math.min(count - 1, Math.trunc(requested) || 0))
+  const start = page * APPLICANT_PAGE_SIZE
+  return { page, count, start, items: applicants.slice(start, start + APPLICANT_PAGE_SIZE) }
+}
diff --git a/lib/pipeline-list.ts b/lib/pipeline-list.ts
new file mode 100644
index 0000000..f82ea0e
--- /dev/null
+++ b/lib/pipeline-list.ts
@@ -0,0 +1,27 @@
+import type { getClubPipeline } from "@/actions/crm"
+
+type Pipeline = Awaited<ReturnType<typeof getClubPipeline>>
+
+/** Run only after the canonical per-applicant privacy and score projection. */
+export function pipelineListProjection(data: Pipeline) {
+  return {
+    rounds: data.rounds,
+    genderCounts: data.genderCounts,
+    applications: data.applications.map(app => {
+      const profile = app.student.studentProfile
+      return {
+        id: app.id, roundId: app.roundId, status: app.status, studentId: app.studentId,
+        student: {
+          email: app.student.email,
+          studentProfile: profile ? {
+            firstName: profile.firstName, lastName: profile.lastName, major: profile.major,
+            academicYear: profile.academicYear, gpa: profile.gpa,
+            satScore: profile.satScore, actScore: profile.actScore,
+          } : null,
+        },
+        evaluations: app.evaluations.map(e => ({ interviewerId: e.interviewerId })),
+        roundScore: app.roundScore,
+      }
+    }),
+  }
+}
