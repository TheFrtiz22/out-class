diff --git a/lib/application-review-visibility.ts b/lib/application-review-visibility.ts
new file mode 100644
index 0000000..fcaa4d1
--- /dev/null
+++ b/lib/application-review-visibility.ts
@@ -0,0 +1,22 @@
+import { interviewCapabilities } from "@/lib/interview-access";
+import { submittedScoreSummary } from "@/lib/interview-review-summary";
+import type { ClubAccess } from "@/lib/permissions";
+
+type Review = { interviewerId: string; roundId: string | null; submittedAt: Date | null; score: number };
+type Assignment = { memberId: string; roundId: string; member: ClubAccess };
+type Viewer = ClubAccess & { id: string; userId: string };
+
+/** Shared by full detail and summary reads. No drafts or hidden scores escape. */
+export function applicationReviewVisibility<T extends Review>(app: {
+  studentId: string; roundId: string; evaluations: T[]; interviewAssignments: Assignment[];
+}, membership: Viewer) {
+  const caps = interviewCapabilities(membership);
+  const assignments = app.interviewAssignments || [];
+  const ownSubmitted = app.evaluations.some(e => e.interviewerId === membership.id && e.roundId === app.roundId && e.submittedAt);
+  const assigned = assignments.some(a => a.roundId === app.roundId && a.memberId === membership.id);
+  const canSeeRound = app.studentId !== membership.userId && ((caps.readClosing && !assigned) || caps.participate && assigned && ownSubmitted);
+  const roundScore = canSeeRound ? submittedScoreSummary(app.evaluations.filter(e => e.roundId === app.roundId), assignments.filter(a => a.roundId === app.roundId && interviewCapabilities(a.member).participate).map(a => a.memberId)) : null;
+  const evaluations = app.evaluations.filter(e => app.studentId !== membership.userId && e.submittedAt &&
+    (caps.participate && e.interviewerId === membership.id && assignments.some(a => a.memberId === membership.id && a.roundId === e.roundId) || canSeeRound && (e.roundId === app.roundId || caps.readClosing)));
+  return { caps, ownSubmitted, assigned, roundScore, evaluations };
+}
diff --git a/lib/pipeline-summary.ts b/lib/pipeline-summary.ts
new file mode 100644
index 0000000..5437f00
--- /dev/null
+++ b/lib/pipeline-summary.ts
@@ -0,0 +1,37 @@
+import type { Prisma } from "@prisma/client";
+import { anonymousListProfile } from "@/lib/anonymous-review";
+import { recruitmentListProfile } from "@/lib/recruitment-profile";
+import { applicationReviewVisibility } from "@/lib/application-review-visibility";
+import { hasPermission, type ClubAccess } from "@/lib/permissions";
+
+/** Database allowlist, independent of future application/profile schema fields.
+ * The complete metadata set is still read to preserve global privacy-aware
+ * filtering/order/counts. Detail, offer, private draft and member content is not. */
+export const pipelineSummarySelect = {
+  id: true, roundId: true, status: true, studentId: true,
+  round: { select: { anonymousReview: true } },
+  student: { select: { email: true, studentProfile: { select: {
+    firstName: true, lastName: true, major: true, gradYear: true,
+    transferStudent: true, gpa: true, satScore: true, actScore: true,
+  } } } },
+  evaluations: { where: { submittedAt: { not: null } }, select: {
+    interviewerId: true, roundId: true, submittedAt: true, score: true,
+  } },
+  interviewAssignments: { where: { revokedAt: null }, select: {
+    memberId: true, roundId: true, member: { select: { status: true, isOwner: true, permissions: true } },
+  } },
+} satisfies Prisma.ApplicationSelect;
+
+type Summary = Prisma.ApplicationGetPayload<{ select: typeof pipelineSummarySelect }>;
+export function pipelineSummaryProjection(app: Summary, membership: ClubAccess & { id: string; userId: string }) {
+  const anonymous = !hasPermission(membership, "applicants.identify") || app.round.anonymousReview;
+  const { evaluations, roundScore } = applicationReviewVisibility(app, membership);
+  return {
+    id: app.id, roundId: app.roundId, status: app.status,
+    studentId: anonymous ? `anonymous-${app.id}` : app.studentId,
+    student: { email: anonymous ? "" : app.student.email,
+      studentProfile: anonymous ? anonymousListProfile(app.id, app.student.studentProfile) :
+        app.student.studentProfile ? recruitmentListProfile(app.student.studentProfile) : null },
+    evaluations: evaluations.map(e => ({ interviewerId: e.interviewerId })), roundScore,
+  };
+}
