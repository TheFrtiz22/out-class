+  protocol.runtimePackageManifests = Object.fromEntries(Object.entries(JSON.parse(fs.readFileSync(path.join(local.repo, 'docs/performance/phase14/RUNTIME_PACKAGES.json')))).map(([name, spec]) => [name, spec.sha256])); save();
