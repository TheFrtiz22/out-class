+  assert.ok(!fs.existsSync(out)); fs.mkdirSync(out);
+  const toolNames = ['navigation-phase14-study.cjs', 'navigation-phase14-local.cjs', 'navigation-audit.cjs', 'navigation-phase14-interactions.cjs', 'navigation-phase14-constrained-interactions.cjs', 'navigation-phase14-concurrency.cjs', 'navigation-phase14-host-monitor.cjs'];
