diff --git a/hooks/use-pipeline-page.ts b/hooks/use-pipeline-page.ts
new file mode 100644
index 0000000..dd9e9ab
--- /dev/null
+++ b/hooks/use-pipeline-page.ts
@@ -0,0 +1,66 @@
+"use client"
+
+import { useCallback, useEffect, useMemo, useRef, useState } from "react"
+import { getClubPipelinePage } from "@/lib/workspace-api"
+import { pipelinePageQuery, type PipelinePageQuery } from "@/lib/pipeline-page"
+import { recordWorkspaceRead } from "@/lib/workspace-read-diagnostics"
+import { serializedWorkspaceRead } from "@/lib/serialized-workspace-read"
+
+type Page = Awaited<ReturnType<typeof getClubPipelinePage>>
+type Context = { clubId: string; authority: object; revision: number; enabled: boolean }
+type Owner = { context: Context; scope: string }
+type Result = { owner: Owner; data: Page | null; failed: boolean }
+const key = (query: PipelinePageQuery) => JSON.stringify(pipelinePageQuery.parse(query))
+
+/** One fresh page per selection. Retained metadata keeps controls editable;
+ * earlier rows stay hidden until the current owner has a validated response. */
+export function usePipelinePage({ clubId, query, revision, authority, enabled, initialData, validatedInitialData }: {
+  clubId: string; query: PipelinePageQuery; revision: number; authority: object; enabled: boolean;
+  initialData: Page | null; validatedInitialData: boolean;
+}) {
+  const parsed = pipelinePageQuery.safeParse(query)
+  const scope = parsed.success ? JSON.stringify(parsed.data) : "invalid"
+  const valid = parsed.success
+  const context = useMemo(() => ({ clubId, authority, revision, enabled }), [clubId, authority, revision, enabled])
+  // A boundary read may supply the next page before its cursor is selected.
+  // Adopt that exact response once, without dispatching the same guarded GET.
+  const prepared = useRef<Owner | null>(null)
+  const owner = useMemo(() => prepared.current?.context === context && prepared.current.scope === scope ? prepared.current : { context, scope }, [context, scope])
+  const [result, setResult] = useState<Result | null>(enabled && valid && validatedInitialData && initialData ? { owner, data: initialData, failed: false } : null)
+  const latest = useRef({ owner, query, valid }), accepted = useRef(result), mounted = useRef(false)
+  latest.current = { owner, query, valid }; accepted.current = result
+  const reader = useRef<ReturnType<typeof serializedWorkspaceRead> | null>(null)
+  useEffect(() => {
+    mounted.current = true
+    const instance = serializedWorkspaceRead(async () => {
+      const request = latest.current
+      if (!request.owner.context.enabled || !request.valid) return { owner: request.owner, data: null, failed: false }
+      recordWorkspaceRead("page", ["dispatch"])
+      try { return { owner: request.owner, data: await getClubPipelinePage(request.owner.context.clubId, request.query), failed: false } }
+      catch { return { owner: request.owner, data: null, failed: true } }
+    }, value => { if (mounted.current && latest.current.owner === value.owner) setResult(value) }, () => {})
+    reader.current = instance
+    return () => { mounted.current = false; instance.dispose(); if (reader.current === instance) reader.current = null }
+  }, [])
+  useEffect(() => {
+    if (enabled && valid && accepted.current?.owner !== owner) void reader.current?.refresh()
+  }, [owner, enabled, valid])
+  const isCurrent = useCallback(() => mounted.current && latest.current.owner === owner, [owner])
+  const setData = useCallback((value: Page | null | ((previous: Page | null) => Page | null)) => {
+    if (!mounted.current || latest.current.owner !== owner) return false
+    setResult(previous => mounted.current && latest.current.owner === owner ? { owner, failed: false,
+      data: typeof value === "function" ? value(previous?.owner === owner ? previous.data : null) : value } : previous)
+    return true
+  }, [owner])
+  const acceptPage = useCallback((data: Page, next: PipelinePageQuery) => {
+    if (!mounted.current || latest.current.owner !== owner) return false
+    const nextScope = key(next)
+    const nextOwner = nextScope === owner.scope ? owner : { context, scope: nextScope }
+    prepared.current = nextOwner; setResult({ owner: nextOwner, data, failed: false })
+    return true
+  }, [context, owner])
+  const retained = enabled && result?.owner.context === context ? result : null
+  const current = retained?.owner === owner ? retained : null
+  return { data: retained?.data ?? null, ready: !!current?.data && valid, invalid: !valid,
+    loading: !retained && !current?.failed, error: current?.failed ?? false, setData, acceptPage, isCurrent }
+}
diff --git a/lib/pipeline-page-read.ts b/lib/pipeline-page-read.ts
new file mode 100644
index 0000000..c70c400
--- /dev/null
+++ b/lib/pipeline-page-read.ts
@@ -0,0 +1,39 @@
+import { APPLICANT_PAGE_SIZE } from "@/lib/applicant-pagination"
+import { pagePipeline, type PipelinePageQuery } from "@/lib/pipeline-page"
+import { pipelineSummarySelect, pipelineSummaryProjection } from "@/lib/pipeline-summary"
+import type { Prisma } from "@prisma/client"
+import type { AppTransactionClient } from "@/utils/prisma"
+import type { ClubAccess } from "@/lib/permissions"
+
+// Ranking does not need review/assignment collections unless the requested
+// filter or sort observes them. Keep canonical JS collation/privacy semantics.
+const { evaluations: _evaluations, interviewAssignments: _assignments, ...metadataSelect } = pipelineSummarySelect
+export const pipelinePageMetadataSelect = metadataSelect
+export function requiresCompleteReviewMetadata(query: PipelinePageQuery) {
+  return query.review !== undefined || query.rating !== undefined || query.sort === "score"
+}
+
+type Member = ClubAccess & { id: string; userId: string }
+type Rounds = ReturnType<typeof pagePipeline>["rounds"]
+export async function readPipelinePage(tx: AppTransactionClient, where: Prisma.ApplicationWhereInput,
+  member: Member, rounds: Rounds, query: PipelinePageQuery, scope: string) {
+  const project = (app: Parameters<typeof pipelineSummaryProjection>[0]) => pipelineSummaryProjection(app, member)
+  if (requiresCompleteReviewMetadata(query)) {
+    const all = await tx.application.findMany({ where, select: pipelineSummarySelect })
+    return pagePipeline({ rounds, genderCounts: null, applications: all.map(project) }, query, member.id, member.userId, scope)
+  }
+  const metadata = await tx.application.findMany({ where, select: pipelinePageMetadataSelect })
+  // Empty review collections are internal ranking placeholders only. This path
+  // is never used for a review/score-dependent selector or returned as content.
+  const ranked = metadata.map(app => project({ ...app, evaluations: [], interviewAssignments: [] }))
+  const page = pagePipeline({ rounds, genderCounts: null, applications: ranked }, query, member.id, member.userId, scope)
+  if (!page.applications.length) return page
+  const ids = page.applications.map(app => app.id)
+  const hydrated = await tx.application.findMany({
+    where: { AND: [where, { id: { in: ids } }] }, take: APPLICANT_PAGE_SIZE, select: pipelineSummarySelect,
+  })
+  const summaries = new Map(hydrated.map(app => [app.id, project(app)]))
+  // The caller holds one Repeatable Read snapshot for planning and hydration.
+  if (ids.some(id => !summaries.has(id))) throw new Error("Applicant page changed during hydration.")
+  return { ...page, applications: ids.map(id => summaries.get(id)!) }
+}
diff --git a/lib/workspace-read-diagnostics.ts b/lib/workspace-read-diagnostics.ts
new file mode 100644
index 0000000..5d84473
--- /dev/null
+++ b/lib/workspace-read-diagnostics.ts
@@ -0,0 +1,9 @@
+// Local observers receive only fixed event labels, never identities, tokens,
+// cookies, filter values, request arguments or authorization results. No buffer.
+export const workspaceReadCauses = ["mount", "dispatch", "user", "readAuthority", "isImpersonating", "clubId", "kind", "privacyScope", "retry", "mode", "demoReady", "demoEnabled", "initial_session", "signed_in", "signed_out", "token_refreshed", "user_updated", "mfa_challenge_verified", "password_recovery"] as const
+export function recordWorkspaceRead(kind: "auth" | "selected" | "page", causes: readonly string[]) {
+  if (typeof window === "undefined" || typeof CustomEvent === "undefined" || typeof window.dispatchEvent !== "function") return
+  if (!["auth", "selected", "page"].includes(kind)) return
+  const safe = causes.filter(cause => workspaceReadCauses.includes(cause as typeof workspaceReadCauses[number]))
+  try { window.dispatchEvent(new CustomEvent("outclass:workspace-read", { detail: { kind, causes: safe } })) } catch { /* Diagnostics must never block an authority change or a read. */ }
+}
