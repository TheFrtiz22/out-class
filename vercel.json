{
  "regions": [
    "pdx1"
  ],
  "build": {
    "env": {
      "NODE_OPTIONS": "--max_old_space_size=4096"
    }
  },
  "crons": [
    {
      "path": "/api/internal/invitation-delivery",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/internal/notification-delivery",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/internal/scheduled-communications",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/internal/graduation",
      "schedule": "23 9 * * *"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "design/platform-wide-visual-unification": false
    }
  }
}
