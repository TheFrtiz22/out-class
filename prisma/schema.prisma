generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// 1. USERS & PROFILES
// ==========================================

model User {
  disabledAt   DateTime?
  id           String    @id @default(uuid())
  email        String    @unique // MUST be @virginia.edu
  passwordHash String? // If using local auth; omitted if using OAuth exclusively
  role         AppRole   @default(STUDENT) // Global role
  createdAt    DateTime  @default(now())

  studentProfile  StudentProfile?
  memberships     ClubMember[]
  applications    Application[]
  attendances     EventAttendance[]
  platformAdmin   PlatformAdmin?
  clubInvitations ClubInvitation[]
  clubClaims      ClubClaim[]
  assignedTasks   ClubTask[]
  taskSubmissions TaskAssignment[]
}

enum AppRole {
  STUDENT
  CLUB_ADMIN
}

model StudentProfile {
  actScore   Int?
  actEnglish Int?
  actMath    Int?
  actReading Int?
  actScience Int?
  id         String @id @default(uuid())
  userId     String @unique
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  firstName   String
  lastName    String
  computingId String  @unique
  major       String
  gradYear    Int
  gpa         Float?
  satScore    Int?
  linkedinUrl String?
  bio         String?
  resumeUrl   String? // S3 URL
  headshotUrl String? // S3 URL

  experiences Experience[]
}

model Experience {
  id               String         @id @default(uuid())
  studentProfileId String
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  title            String
  subtitle         String
  period           String
}

// ==========================================
// 2. CLUBS & CRM SETUP
// ==========================================

model Club {
  interviewSlots  InterviewSlot[]
  campusKey       String           @default("uva")
  directorySource String?
  claimedAt       DateTime?
  testRequirement String           @default("OPTIONAL")
  invitations     ClubInvitation[]
  claims          ClubClaim[]
  tasks           ClubTask[]
  id              String           @id @default(uuid())
  slug            String           @unique
  name            String
  tagline         String
  description     String
  logoUrl         String?
  bannerUrl       String?
  color           String
  category        String
  acceptanceRate  Float?
  aumValue        Float?

  members        ClubMember[]
  events         Meeting[]
  applications   Application[]
  pipelineRounds PipelineRound[]
  questions      ApplicationQuestion[]
}

model ClubMember {
  groups           String[]          @default([])
  cohort           String?
  taskAssignments  TaskAssignment[]
  isOwner          Boolean           @default(false)
  permissions      String[]          @default([])
  interviewRecords InterviewRecord[]
  id               String            @id @default(uuid())
  userId           String
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  clubId           String
  club             Club              @relation(fields: [clubId], references: [id], onDelete: Cascade)
  role             ClubRole          @default(GENERAL_MEMBER)
  title            String? // e.g., "VP of Recruitment"

  evaluations Evaluation[]

  @@unique([userId, clubId])
}

enum ClubRole {
  PRESIDENT
  RECRUITMENT_LEAD
  GENERAL_MEMBER
}

// ==========================================
// 3. APPLICATIONS & EVALUATIONS
// ==========================================

model PipelineRound {
  anonymousReview  Boolean           @default(false)
  interviewKit     Json              @default("[]")
  kitVersion       Int               @default(0)
  interviewRecords InterviewRecord[]
  id               String            @id @default(uuid())
  clubId           String
  club             Club              @relation(fields: [clubId], references: [id], onDelete: Cascade)
  name             String // e.g., "Applied", "Round 1", "Decision"
  order            Int

  applications Application[]
}

model ApplicationQuestion {
  id        String       @id @default(uuid())
  clubId    String
  club      Club         @relation(fields: [clubId], references: [id], onDelete: Cascade)
  prompt    String
  type      QuestionType // ESSAY, FILE, MULTIPLE_CHOICE
  required  Boolean      @default(true)
  wordLimit Int?

  answers ApplicationAnswer[]
}

enum QuestionType {
  ESSAY
  FILE_UPLOAD
  MULTIPLE_CHOICE
}

model Application {
  anonymousReviewText String?
  interviewRecords    InterviewRecord[]
  id                  String            @id @default(uuid())
  studentId           String
  student             User              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  clubId              String
  club                Club              @relation(fields: [clubId], references: [id], onDelete: Cascade)
  roundId             String
  round               PipelineRound     @relation(fields: [roundId], references: [id])
  status              AppStatus         @default(DRAFTING)

  submittedAt DateTime?

  answers     ApplicationAnswer[]
  evaluations Evaluation[]
  bookings    InterviewBooking[]

  @@unique([studentId, clubId])
}

enum AppStatus {
  DRAFTING
  SUBMITTED
  IN_REVIEW
  INTERVIEWING
  ACCEPTED
  REJECTED
  WAITLISTED
}

model ApplicationAnswer {
  id            String              @id @default(uuid())
  applicationId String
  application   Application         @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  questionId    String
  question      ApplicationQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  response      String // Text or S3 URL for files

  @@unique([applicationId, questionId])
}

model Evaluation {
  id            String      @id @default(uuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  interviewerId String
  interviewer   ClubMember  @relation(fields: [interviewerId], references: [id], onDelete: Cascade)

  round     String // e.g., "Round 1"
  score     Float
  notes     String?
  createdAt DateTime @default(now())

  @@unique([applicationId, interviewerId, round])
}

// ==========================================
// 4. EVENTS & ATTENDANCE
// ==========================================

model Meeting {
  audience      String                @default("RECRUITMENT")
  endDate       DateTime?
  agenda        String                @default("")
  recap         String                @default("")
  resources     Json                  @default("[]")
  revision      Int                   @default(0)
  checkInTokens MeetingCheckInToken[]
  id            String                @id @default(uuid())
  clubId        String
  club          Club                  @relation(fields: [clubId], references: [id], onDelete: Cascade)
  title         String
  date          DateTime
  location      String
  description   String?
  isPublic      Boolean               @default(true)

  attendances EventAttendance[]

  @@map("Event")
}

model EventAttendance {
  id          String   @id @default(uuid())
  eventId     String
  event       Meeting  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  studentId   String
  student     User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  checkedInAt DateTime @default(now())

  @@unique([eventId, studentId])
}

// ==========================================
// 5. SCHEDULING
// ==========================================

model InterviewSlot {
  id        String   @id @default(uuid())
  clubId    String
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  startTime DateTime
  endTime   DateTime
  location  String
  capacity  Int      @default(1)

  bookings InterviewBooking[]
}

model InterviewBooking {
  id            String        @id @default(uuid())
  slotId        String
  slot          InterviewSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  applicationId String
  application   Application   @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([slotId, applicationId])
}

model InterviewRecord {
  id              String        @id @default(uuid())
  applicationId   String
  application     Application   @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  interviewerId   String
  interviewer     ClubMember    @relation(fields: [interviewerId], references: [id], onDelete: Restrict)
  roundId         String
  round           PipelineRound @relation(fields: [roundId], references: [id], onDelete: Restrict)
  questions       Json
  draft           Json
  anonymousReview Boolean
  revision        Int           @default(0)
  completedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([applicationId, interviewerId, roundId])
}

model PlatformAdmin {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String
  action    String
  targetId  String
  clubId    String?
  reason    String?
  details   Json?
  createdAt DateTime @default(now())

  @@index([clubId, createdAt])
  @@index([actorId, createdAt])
}

model ClubInvitation {
  id          String    @id @default(uuid())
  club        Club      @relation(fields: [clubId], references: [id], onDelete: Cascade)
  inviter     User      @relation(fields: [invitedBy], references: [id], onDelete: Cascade)
  clubId      String
  email       String
  permissions String[]
  invitedBy   String
  expiresAt   DateTime
  declinedAt  DateTime?
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([email, clubId])
}

model ClubClaim {
  id          String   @id @default(uuid())
  club        Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clubId      String
  userId      String
  explanation String
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())

  @@index([clubId, status])
}

model ClubTask {
  kind         String           @default("TASK")
  projectId    String?
  project      ClubTask?        @relation("ProjectTasks", fields: [projectId], references: [id], onDelete: SetNull)
  tasks        ClubTask[]       @relation("ProjectTasks")
  resources    Json             @default("[]")
  requirements String[]         @default([])
  audience     Json             @default("{}")
  revision     Int              @default(0)
  assignments  TaskAssignment[]
  id           String           @id @default(uuid())
  club         Club             @relation(fields: [clubId], references: [id], onDelete: Cascade)
  assignee     User?            @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  clubId       String
  title        String
  description  String           @default("")
  assigneeId   String?
  status       String           @default("OPEN")
  dueAt        DateTime?
  createdAt    DateTime         @default(now())

  @@index([clubId, status])
}

model PlatformContent {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}

model MeetingCheckInToken {
  id        String   @id @default(uuid())
  meetingId String
  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  issuedBy  String
  createdAt DateTime @default(now())

  @@index([meetingId, expiresAt])
}

model TaskAssignment {
  id          String      @id @default(uuid())
  taskId      String
  task        ClubTask    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  memberId    String?
  member      ClubMember? @relation(fields: [memberId], references: [id], onDelete: SetNull)
  userId      String
  recipient   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedAt  DateTime    @default(now())
  viewedAt    DateTime?
  text        String      @default("")
  link        String      @default("")
  submittedAt DateTime?
  reviewedAt  DateTime?
  reviewedBy  String?
  feedback    String      @default("")
  revision    Int         @default(0)
  files       TaskFile[]

  @@unique([taskId, memberId])
  @@index([memberId])
}

model TaskFile {
  id           String         @id @default(uuid())
  assignmentId String
  assignment   TaskAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  name         String
  path         String         @unique
  size         Int
  mime         String
  submitted    Boolean        @default(false)
  createdAt    DateTime       @default(now())

  @@index([assignmentId])
}

model PlatformViewSession {
  id           String    @id @default(uuid())
  tokenHash    String    @unique
  actorId      String
  targetUserId String
  clubId       String?
  reason       String
  createdAt    DateTime  @default(now())
  expiresAt    DateTime
  endedAt      DateTime?

  @@index([actorId, endedAt])
}
