generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// 1. USERS & PROFILES
// ==========================================

model User {
  id            String    @id @default(uuid())
  email         String    @unique // MUST be @virginia.edu
  passwordHash  String?   // If using local auth; omitted if using OAuth exclusively
  role          AppRole   @default(STUDENT) // Global role
  createdAt     DateTime  @default(now())
  
  studentProfile StudentProfile?
  memberships    ClubMember[]
  applications   Application[]
  attendances    EventAttendance[]
  platformAdmin PlatformAdmin?
  clubInvitations ClubInvitation[]
  clubClaims ClubClaim[]
  assignedTasks ClubTask[]
}

enum AppRole {
  STUDENT
  CLUB_ADMIN
}

model StudentProfile {
  id             String   @id @default(uuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  firstName      String
  lastName       String
  computingId    String   @unique
  major          String
  gradYear       Int
  gpa            Float?
  satScore       Int?
  linkedinUrl    String?
  bio            String?
  resumeUrl      String?  // S3 URL
  headshotUrl    String?  // S3 URL

  experiences Experience[]
}

model Experience {
  id               String         @id @default(uuid())
  studentProfileId String
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  title            String
  subtitle         String
  period           String
}

// ==========================================
// 2. CLUBS & CRM SETUP
// ==========================================

model Club {
  id             String   @id @default(uuid())
  slug           String   @unique
  name           String
  tagline        String
  description    String
  logoUrl        String?
  bannerUrl      String?
  color          String
  category       String
  acceptanceRate Float?
  aumValue       Float?

  members        ClubMember[]
  events         Event[]
  applications   Application[]
  pipelineRounds PipelineRound[]
  questions      ApplicationQuestion[]
}

model ClubMember {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clubId    String
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  role      ClubRole @default(GENERAL_MEMBER)
  title     String?  // e.g., "VP of Recruitment"

  evaluations Evaluation[]

  @@unique([userId, clubId])
}

enum ClubRole {
  PRESIDENT
  RECRUITMENT_LEAD
  GENERAL_MEMBER
}

// ==========================================
// 3. APPLICATIONS & EVALUATIONS
// ==========================================

model PipelineRound {
  id       String   @id @default(uuid())
  clubId   String
  club     Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  name     String   // e.g., "Applied", "Round 1", "Decision"
  order    Int
  
  applications Application[]
}

model ApplicationQuestion {
  id        String       @id @default(uuid())
  clubId    String
  club      Club         @relation(fields: [clubId], references: [id], onDelete: Cascade)
  prompt    String
  type      QuestionType // ESSAY, FILE, MULTIPLE_CHOICE
  required  Boolean      @default(true)
  wordLimit Int?

  answers ApplicationAnswer[]
}

enum QuestionType {
  ESSAY
  FILE_UPLOAD
  MULTIPLE_CHOICE
}

model Application {
  id        String   @id @default(uuid())
  studentId String
  student   User          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  clubId    String
  club      Club          @relation(fields: [clubId], references: [id], onDelete: Cascade)
  roundId   String
  round     PipelineRound @relation(fields: [roundId], references: [id])
  status    AppStatus     @default(DRAFTING)

  submittedAt DateTime?

  answers     ApplicationAnswer[]
  evaluations Evaluation[]
  bookings    InterviewBooking[]

  @@unique([studentId, clubId])
}

enum AppStatus {
  DRAFTING
  SUBMITTED
  IN_REVIEW
  INTERVIEWING
  ACCEPTED
  REJECTED
  WAITLISTED
}

model ApplicationAnswer {
  id            String              @id @default(uuid())
  applicationId String
  application   Application         @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  questionId    String
  question      ApplicationQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  response      String // Text or S3 URL for files

  @@unique([applicationId, questionId])
}

model Evaluation {
  id            String      @id @default(uuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  interviewerId String
  interviewer   ClubMember  @relation(fields: [interviewerId], references: [id], onDelete: Cascade)

  round     String // e.g., "Round 1"
  score     Float
  notes     String?
  createdAt DateTime @default(now())

  @@unique([applicationId, interviewerId, round])
}

// ==========================================
// 4. EVENTS & ATTENDANCE
// ==========================================

model Event {
  id          String   @id @default(uuid())
  clubId      String
  club        Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  title       String
  date        DateTime
  location    String
  description String?
  isPublic    Boolean  @default(true)

  attendances EventAttendance[]
}

model EventAttendance {
  id          String   @id @default(uuid())
  eventId     String
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  studentId   String
  student     User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  checkedInAt DateTime @default(now())

  @@unique([eventId, studentId])
}

// ==========================================
// 5. SCHEDULING
// ==========================================

model InterviewSlot {
  id        String   @id @default(uuid())
  clubId    String
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  startTime DateTime
  endTime   DateTime
  location  String
  capacity  Int      @default(1)

  bookings InterviewBooking[]
}

model InterviewBooking {
  id            String        @id @default(uuid())
  slotId        String
  slot          InterviewSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  applicationId String
  application   Application   @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([slotId, applicationId])
}

