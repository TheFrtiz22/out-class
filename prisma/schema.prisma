generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// 1. USERS & PROFILES
// ==========================================

model User {
  approvedInterviewPanels InterviewRoom[] @relation("RoomPanelApprover")
  interviewPanelGrants InterviewPanelAssignment[] @relation("InterviewPanelGrantor")
  interviewAnnotationRevisions InterviewAnnotationRevision[] @relation("InterviewAnnotationActor")
  corkboardClubs CorkboardClub[]
  reviewObservations ApplicantObservation[]
  schoolIdentities SchoolIdentity[]
  rosterImports    RosterImport[]
  claimedInvitations ClubInvitation[] @relation("ClaimedInvitation")
  invitationDeliveries InvitationDelivery[]
  matchedRosterRows RosterImportRow[]
  disabledAt DateTime? @db.Timestamptz(3)
  id         String    @id @default(uuid())
  email      String    @unique // MUST be @virginia.edu
  role       AppRole   @default(STUDENT) // Global role
  createdAt  DateTime  @default(now())

  tutorials       UserTutorial[]
  studentProfile  StudentProfile?
  memberships     ClubMember[]
  applications    Application[]
  attendances     EventAttendance[]
  platformAdmin   PlatformAdmin?
  clubInvitations ClubInvitation[]
  clubClaims      ClubClaim[]
  assignedTasks   ClubTask[]
  taskSubmissions TaskAssignment[]
}

enum AppRole {
  STUDENT
  CLUB_ADMIN
}

model StudentProfile {
  scholarStatus Json?
  actScore   Int?
  actEnglish Int?
  actMath    Int?
  actReading Int?
  actScience Int?
  id         String @id @default(uuid())
  userId     String @unique
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  firstName   String
  lastName    String
  computingId String  @unique
  major       String
  gradYear    Int
  gpa         Float?
  satScore    Int?
  linkedinUrl String?
  bio         String?
  resumeUrl   String? // S3 URL
  headshotUrl String? // S3 URL

  experiences Experience[]
}

model Experience {
  id               String         @id @default(uuid())
  studentProfileId String
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  title            String
  subtitle         String
  period           String
}

// ==========================================
// 2. CLUBS & CRM SETUP
// ==========================================

model Club {
  applicationOpen Boolean @default(true)
  applicationDeadline DateTime?
  applicationVersion Int @default(0)
  pipelineVersion Int @default(0)
  isDiscoverable Boolean @default(true)
  invitationEmailEnabled Boolean @default(true)
  corkboardSaves CorkboardClub[]
  votingSessions VotingSession[]
  schoolId            String           @default("school-uva")
  school              School           @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  rosterImports       RosterImport[]
  marketing           Json?
  marketingApprovedAt DateTime? // Explicit consent to appear as a launch participant.
  interviewRooms      InterviewRoom[]
  interviewSlots      InterviewSlot[]
  campusKey           String           @default("uva")
  directorySource     String?
  claimedAt           DateTime?
  testRequirement     String           @default("OPTIONAL")
  invitations         ClubInvitation[]
  claims              ClubClaim[]
  tasks               ClubTask[]
  id                  String           @id @default(uuid())
  slug                String           @unique
  name                String
  tagline             String
  description         String
  logoUrl             String?
  bannerUrl           String?
  color               String
  category            String
  acceptanceRate      Float?
  aumValue            Float?

  members        ClubMember[]
  events         Meeting[]
  applications   Application[]
  pipelineRounds PipelineRound[]
  questions      ApplicationQuestion[]
  @@unique([id, schoolId])
}

model ClubMember {
  interviewOffices String[] @default([])
  interviewAssignments InterviewPanelAssignment[]
  resumeAnnotations InterviewResumeAnnotation[]
  votingParticipants VotingParticipant[]
  accessRole       MembershipAccessRole @default(MEMBER)
  status           MembershipStatus     @default(ACTIVE)
  joinedAt         DateTime             @default(now())
  updatedAt        DateTime             @default(now()) @updatedAt
  groups           String[]          @default([])
  cohort           String?
  taskAssignments  TaskAssignment[]
  isOwner          Boolean           @default(false)
  permissions      String[]          @default([])
  interviewRecords InterviewRecord[]
  id               String            @id @default(uuid())
  userId           String
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  clubId           String
  club             Club              @relation(fields: [clubId], references: [id], onDelete: Cascade)
  role             ClubRole          @default(GENERAL_MEMBER)
  title            String? // e.g., "VP of Recruitment"

  evaluations Evaluation[]

  @@unique([userId, clubId])
  @@index([clubId], map: "ClubMember_clubId_idx")
  @@index([clubId, status, joinedAt])
}

enum ClubRole {
  PRESIDENT
  RECRUITMENT_LEAD
  GENERAL_MEMBER
}

// ==========================================
// 3. APPLICATIONS & EVALUATIONS
// ==========================================

model PipelineRound {
  stableEvaluations Evaluation[] @relation("EvaluationRound")
  interviewAssignments InterviewPanelAssignment[]
  resumeDocuments InterviewResumeDocument[]
  type String @default("CUSTOM")
  archivedAt DateTime?
  configuration Json @default("{}")
  votingSessions VotingSession[]
  applicantDisplay Json @default("{}")
  displayVersion Int @default(0)
  interviewRooms    InterviewRoom[]
  scheduledBookings InterviewBooking[]
  screeningRule     RecruitingRule?
  anonymousReview   Boolean            @default(false)
  interviewKit      Json               @default("[]")
  kitVersion        Int                @default(0)
  interviewRecords  InterviewRecord[]
  id                String             @id @default(uuid())
  clubId            String
  club              Club               @relation(fields: [clubId], references: [id], onDelete: Cascade)
  name              String // e.g., "Applied", "Round 1", "Decision"
  order             Int

  applications Application[]

  @@index([clubId], map: "PipelineRound_clubId_idx")
  @@index([clubId, archivedAt, order])
}

model ApplicationQuestion {
  order Int @default(0)
  options String[] @default([])
  archivedAt DateTime?
  id        String       @id @default(uuid())
  clubId    String
  club      Club         @relation(fields: [clubId], references: [id], onDelete: Cascade)
  prompt    String
  type      QuestionType // ESSAY, FILE, MULTIPLE_CHOICE
  required  Boolean      @default(true)
  wordLimit Int?

  answers ApplicationAnswer[]

  @@index([clubId], map: "ApplicationQuestion_clubId_idx")
  @@index([clubId, archivedAt, order])
}

enum QuestionType {
  ESSAY
  FILE_UPLOAD
  MULTIPLE_CHOICE
}

model Application {
  interviewAssignments InterviewPanelAssignment[]
  resumeDocuments InterviewResumeDocument[]
  votingCandidates VotingCandidate[]
  observations ApplicantObservation[]
  recruitingFlags     RecruitingRuleFlag[]
  anonymousReviewText String?
  interviewRecords    InterviewRecord[]
  id                  String               @id @default(uuid())
  studentId           String
  student             User                 @relation(fields: [studentId], references: [id], onDelete: Cascade)
  clubId              String
  club                Club                 @relation(fields: [clubId], references: [id], onDelete: Cascade)
  roundId             String
  round               PipelineRound        @relation(fields: [roundId], references: [id])
  status              AppStatus            @default(DRAFTING)

  submittedAt DateTime?

  answers     ApplicationAnswer[]
  evaluations Evaluation[]
  bookings    InterviewBooking[]

  @@unique([studentId, clubId])
  @@index([clubId], map: "Application_clubId_idx")
  @@index([roundId], map: "Application_roundId_idx")
  @@index([studentId], map: "Application_studentId_idx")
  @@index([clubId, status, roundId])
}

enum AppStatus {
  DRAFTING
  SUBMITTED
  IN_REVIEW
  INTERVIEWING
  ACCEPTED
  REJECTED
  WAITLISTED
}

model ApplicationAnswer {
  id            String              @id @default(uuid())
  applicationId String
  application   Application         @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  questionId    String
  question      ApplicationQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  response      String // Text or S3 URL for files

  @@unique([applicationId, questionId])
}

model Evaluation {
  roundId String?
  stableRound PipelineRound? @relation("EvaluationRound", fields: [roundId], references: [id], onDelete: Restrict)
  submittedAt DateTime?
  applicantQuestions String?
  interviewRecords InterviewRecord[]
  id            String      @id @default(uuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  interviewerId String
  interviewer   ClubMember  @relation(fields: [interviewerId], references: [id], onDelete: Cascade)

  round     String // e.g., "Round 1"
  score     Float
  notes     String?
  createdAt DateTime @default(now())

  @@unique([applicationId, interviewerId, roundId])
}

// ==========================================
// 4. EVENTS & ATTENDANCE
// ==========================================

model Meeting {
  audience      String                @default("RECRUITMENT")
  endDate       DateTime?
  agenda        String                @default("")
  recap         String                @default("")
  resources     Json                  @default("[]")
  revision      Int                   @default(0)
  checkInTokens MeetingCheckInToken[]
  id            String                @id @default(uuid())
  clubId        String
  club          Club                  @relation(fields: [clubId], references: [id], onDelete: Cascade)
  title         String
  date          DateTime
  location      String
  description   String?
  isPublic      Boolean               @default(true)

  attendances EventAttendance[]

  @@index([clubId], map: "Event_clubId_idx")
  @@map("Event")
}

model EventAttendance {
  id          String   @id @default(uuid())
  eventId     String
  event       Meeting  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  studentId   String
  student     User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  checkedInAt DateTime @default(now())

  @@unique([eventId, studentId])
  @@index([studentId], map: "EventAttendance_studentId_idx")
}

// ==========================================
// 5. SCHEDULING
// ==========================================

model InterviewRoom {
  id             String          @id @default(uuid())
  clubId         String
  club           Club            @relation(fields: [clubId], references: [id], onDelete: Cascade)
  roundId        String
  round          PipelineRound   @relation(fields: [roundId], references: [id], onDelete: Restrict)
  name           String
  location       String
  kind           String
  timezone       String
  duration       Int
  buffer         Int             @default(0)
  isOpen         Boolean         @default(true)
  panelMemberIds String[]        @default([])
  approvedPanelMemberIds String[] @default([])
  panelApprovedBy String?
  panelApprover User? @relation("RoomPanelApprover", fields: [panelApprovedBy], references: [id], onDelete: Restrict)
  panelApprovalRevision Int @default(0)
  createdAt      DateTime        @default(now())
  slots          InterviewSlot[]

  @@index([clubId, roundId])
}

model InterviewSlot {
  roomId String?
  room   InterviewRoom? @relation(fields: [roomId], references: [id], onDelete: Cascade)

  id        String   @id @default(uuid())
  clubId    String
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  startTime DateTime
  endTime   DateTime
  location  String
  capacity  Int      @default(1)

  bookings InterviewBooking[]

  @@index([clubId], map: "InterviewSlot_clubId_idx")
  @@index([roomId, startTime])
  @@index([clubId, startTime])
}

model InterviewBooking {
  roundId       String?
  round         PipelineRound? @relation(fields: [roundId], references: [id], onDelete: Restrict)
  createdAt     DateTime       @default(now())
  id            String         @id @default(uuid())
  slotId        String
  slot          InterviewSlot  @relation(fields: [slotId], references: [id], onDelete: Cascade)
  applicationId String
  application   Application    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  panelAssignments InterviewPanelAssignment[]

  @@unique([slotId, applicationId])
  @@unique([applicationId, roundId])
}

model InterviewRecord {
  evaluationId String?
  evaluation Evaluation? @relation(fields: [evaluationId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  id              String        @id @default(uuid())
  applicationId   String
  application     Application   @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  interviewerId   String
  interviewer     ClubMember    @relation(fields: [interviewerId], references: [id], onDelete: Restrict)
  roundId         String
  round           PipelineRound @relation(fields: [roundId], references: [id], onDelete: Restrict)
  questions       Json
  draft           Json
  anonymousReview Boolean
  revision        Int           @default(0)
  completedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([evaluationId])
  @@unique([applicationId, interviewerId, roundId])
}

model PlatformAdmin {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model AuditLog {
  effectiveUserId String?
  supportSessionId String?
  id        String   @id @default(uuid())
  actorId   String
  action    String
  targetId  String
  clubId    String?
  reason    String?
  details   Json?
  createdAt DateTime @default(now())

  @@index([clubId, createdAt])
  @@index([actorId, createdAt])
}

model ClubInvitation {
  firstEmailSentAt    DateTime?
  lastEmailSentAt     DateTime?
  emailSendCount      Int                       @default(0)
  schoolId           String                    @default("school-uva")
  school             School                    @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  schoolIdentityId   String?
  schoolIdentity     SchoolIdentity?           @relation(fields: [schoolIdentityId, schoolId], references: [id, schoolId], onDelete: Restrict)
  invitedName        String?
  invitedYear        String?
  requestedRole      MembershipAccessRole      @default(MEMBER)
  purpose            InvitationPurpose         @default(ACCESS_GRANT)
  authoritySource    InvitationAuthoritySource @default(CLUB_MEMBER)
  status             InvitationStatus          @default(PENDING)
  claimedUserId      String?
  claimedUser        User?                     @relation("ClaimedInvitation", fields: [claimedUserId], references: [id], onDelete: Restrict)
  claimedAt          DateTime?
  dismissedAt        DateTime?
  expiredAt          DateTime?
  updatedAt          DateTime                  @default(now()) @updatedAt
  rosterRows         RosterImportRow[]
  deliveries         InvitationDelivery[]
  id          String    @id @default(uuid())
  club        Club      @relation(fields: [clubId, schoolId], references: [id, schoolId], onDelete: Restrict)
  inviter     User      @relation(fields: [invitedBy], references: [id], onDelete: Restrict)
  clubId      String
  email       String
  permissions String[]  @default([])
  invitedBy   String
  expiresAt   DateTime
  declinedAt  DateTime?
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([email, clubId])
  @@index([schoolIdentityId, status])
  @@index([clubId, status, createdAt])
  @@unique([id, clubId])
}

model ClubClaim {
  id          String   @id @default(uuid())
  club        Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clubId      String
  userId      String
  explanation String
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())

  @@index([clubId, status])
}

model ClubTask {
  kind         String           @default("TASK")
  projectId    String?
  project      ClubTask?        @relation("ProjectTasks", fields: [projectId], references: [id], onDelete: SetNull)
  tasks        ClubTask[]       @relation("ProjectTasks")
  resources    Json             @default("[]")
  requirements String[]         @default([])
  audience     Json             @default("{}")
  revision     Int              @default(0)
  assignments  TaskAssignment[]
  id           String           @id @default(uuid())
  club         Club             @relation(fields: [clubId], references: [id], onDelete: Cascade)
  assignee     User?            @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  clubId       String
  title        String
  description  String           @default("")
  assigneeId   String?
  status       String           @default("OPEN")
  dueAt        DateTime?
  createdAt    DateTime         @default(now())

  @@index([clubId, status])
}

model PlatformContent {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}

model MeetingCheckInToken {
  id        String   @id @default(uuid())
  meetingId String
  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  issuedBy  String
  createdAt DateTime @default(now())

  @@index([meetingId, expiresAt])
}

model TaskAssignment {
  id          String      @id @default(uuid())
  taskId      String
  task        ClubTask    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  memberId    String?
  member      ClubMember? @relation(fields: [memberId], references: [id], onDelete: SetNull)
  userId      String
  recipient   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedAt  DateTime    @default(now())
  viewedAt    DateTime?
  text        String      @default("")
  link        String      @default("")
  submittedAt DateTime?
  reviewedAt  DateTime?
  reviewedBy  String?
  revisionRequestedAt DateTime?
  groupLabel String?
  feedback    String      @default("")
  revision    Int         @default(0)
  files       TaskFile[]

  @@unique([taskId, memberId])
  @@index([memberId])
  @@index([taskId, submittedAt, reviewedAt], map: "TaskAssignment_review_queue_idx")
}

model TaskFile {
  id           String         @id @default(uuid())
  assignmentId String
  assignment   TaskAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  name         String
  path         String         @unique
  size         Int
  mime         String
  submitted    Boolean        @default(false)
  createdAt    DateTime       @default(now())

  @@index([assignmentId])
}

model PlatformViewSession {
  mode         String    @default("READ_ONLY")
  id           String    @id @default(uuid())
  tokenHash    String    @unique
  actorId      String
  targetUserId String
  clubId       String?
  reason       String
  createdAt    DateTime  @default(now())
  expiresAt    DateTime
  endedAt      DateTime?

  @@index([actorId, endedAt])
}

// Screening suggestions are deliberately separate from application decisions.
model RecruitingRule {
  roundId   String               @id
  round     PipelineRound        @relation(fields: [roundId], references: [id], onDelete: Cascade)
  minGpa    Float?
  minSat    Int?
  minAct    Int?
  revision  Int                  @default(1)
  updatedAt DateTime             @updatedAt
  flags     RecruitingRuleFlag[]
}

model RecruitingRuleFlag {
  roundId       String
  rule          RecruitingRule @relation(fields: [roundId], references: [roundId], onDelete: Cascade)
  applicationId String
  application   Application    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  ruleRevision  Int
  reasons       String[]
  flaggedBy     String
  flaggedAt     DateTime       @default(now())

  @@id([roundId, applicationId])
}

// Separate progress for each experience; server-only, never browser-writable.
model UserTutorial {
  userId     String
  experience String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status     String   @default("IN_PROGRESS")
  step       Int      @default(0)
  version    Int      @default(1)
  updatedAt  DateTime @updatedAt

  @@id([userId, experience])
}

// Onboarding uses school identities, never placeholder User records.
model School {
  id              String @id @default(uuid())
  key             String @unique
  name            String
  active          Boolean @default(true)
  identifierTypes SchoolIdentifierType[]
  identities      SchoolIdentity[]
  clubs           Club[]
  invitations     ClubInvitation[]
  createdAt       DateTime @default(now())
}

model SchoolIdentifierType {
  id               String @id @default(uuid())
  schoolId         String
  school           School @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  key              String
  label            String
  normalization    IdentifierNormalization @default(TRIM_LOWERCASE)
  validationRegex  String?
  verification     IdentityVerification @default(UNCONFIGURED)
  emailDomain      String?
  identities       SchoolIdentity[]
  @@unique([schoolId, key])
  @@unique([id, schoolId])
}

model SchoolIdentity {
  id                   String @id @default(uuid())
  schoolId             String
  school               School @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  identifierTypeId     String
  identifierType       SchoolIdentifierType @relation(fields: [identifierTypeId, schoolId], references: [id, schoolId], onDelete: Restrict)
  identifier           String
  normalizedIdentifier String
  userId               String?
  user                 User? @relation(fields: [userId], references: [id], onDelete: Restrict)
  verifiedAt           DateTime?
  verificationMethod   IdentityVerification?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @default(now()) @updatedAt
  invitations          ClubInvitation[]
  rosterRows           RosterImportRow[]
  @@unique([schoolId, identifierTypeId, normalizedIdentifier])
  @@unique([id, schoolId])
  @@index([userId, schoolId])
}

model RosterImport {
  id             String @id @default(uuid())
  clubId         String
  club           Club @relation(fields: [clubId], references: [id], onDelete: Restrict)
  uploadedById   String
  uploadedBy     User @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  filename       String
  fileHash       String?
  idempotencyKey String
  status         RosterImportStatus @default(VALIDATED)
  rowCount       Int @default(0)
  successfulRows Int @default(0)
  failedRows     Int @default(0)
  validationVersion Int @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt
  completedAt    DateTime?
  rows           RosterImportRow[]
  @@unique([clubId, idempotencyKey])
  @@unique([id, clubId])
  @@index([clubId, createdAt])
}

model RosterImportRow {
  id                   String @id @default(uuid())
  importId             String
  clubId               String
  import               RosterImport @relation(fields: [importId, clubId], references: [id, clubId], onDelete: Restrict)
  rowNumber            Int
  input                Json
  invitedName          String?
  invitedYear          String?
  identifier           String?
  normalizedIdentifier String?
  schoolIdentityId     String?
  schoolIdentity       SchoolIdentity? @relation(fields: [schoolIdentityId], references: [id], onDelete: Restrict)
  matchedUserId        String?
  matchedUser          User? @relation(fields: [matchedUserId], references: [id], onDelete: Restrict)
  invitationId         String?
  invitation           ClubInvitation? @relation(fields: [invitationId, clubId], references: [id, clubId], onDelete: Restrict)
  status               RosterRowStatus @default(PENDING)
  errors               Json @default("[]")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @default(now()) @updatedAt
  @@unique([importId, rowNumber])
  @@index([invitationId])
}

model InvitationDelivery {
  id                String @id @default(uuid())
  invitationId      String
  invitation        ClubInvitation @relation(fields: [invitationId], references: [id], onDelete: Restrict)
  requestedById     String
  requestedBy       User @relation(fields: [requestedById], references: [id], onDelete: Restrict)
  recipientEmail    String
  templateVersion   Int @default(1)
  idempotencyKey    String @unique
  status            InvitationDeliveryStatus @default(QUEUED)
  providerMessageId String? @unique
  attemptCount      Int @default(0)
  nextAttemptAt     DateTime @default(now())
  sentAt            DateTime?
  deliveredAt       DateTime?
  failedAt          DateTime?
  failureCode       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now()) @updatedAt
  @@index([status, nextAttemptAt])
  @@index([invitationId, createdAt])
  @@index([requestedById, createdAt])
}

enum MembershipAccessRole {
  OWNER
  ADMIN
  RECRUITING_ADMIN
  INTERVIEWER
  MEMBER
}
enum MembershipStatus {
  ACTIVE
  SUSPENDED
  LEFT
}
enum IdentifierNormalization {
  TRIM_LOWERCASE
  TRIM
}
enum IdentityVerification {
  UNCONFIGURED
  EMAIL_LOCAL_PART
  INSTITUTIONAL_SSO
}
enum InvitationPurpose {
  OWNER_DESIGNATION
  MEMBERSHIP
  ACCESS_GRANT
}
enum InvitationAuthoritySource {
  PLATFORM_ADMIN
  CLUB_MEMBER
}
enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  REVOKED
  EXPIRED
}
enum RosterImportStatus {
  VALIDATED
  INVALID
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}
enum RosterRowStatus {
  PENDING
  VALID
  INVALID
  DUPLICATE_ROW
  ALREADY_MEMBER
  INVITATION_REUSED
  INVITATION_CREATED
  FAILED
}
enum InvitationDeliveryStatus {
  QUEUED
  SENDING
  SENT
  DELIVERED
  FAILED
  CANCELLED
}

// Structured reviewer observations, independent of scored evaluations and private interview notes.
model ApplicantObservation {
  id String @id @default(uuid())
  applicationId String
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  authorId String
  author User @relation(fields: [authorId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  kind String
  body String
  anonymousReview Boolean
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([applicationId, createdAt])
  @@index([authorId])
}

// Durable decisions are separate from published application statuses.
model VotingSession {
  id String @id @default(uuid())
  clubId String
  club Club @relation(fields: [clubId], references: [id], onDelete: Restrict)
  roundId String
  round PipelineRound @relation(fields: [roundId], references: [id], onDelete: Restrict)
  state String @default("DRAFT")
  targetSize Int
  autoAdvance String @default("NONE")
  threshold Int @default(100)
  displayConfig Json @default("{}")
  joinOpenedAt DateTime?
  activeApplicationId String?
  currentPass Int @default(0)
  revision Int @default(0)
  createdBy String
  startedAt DateTime?
  endedAt DateTime?
  publishedAt DateTime?
  publishedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  participants VotingParticipant[]
  candidates VotingCandidate[]
  passes VotingPass[]
  @@index([clubId, roundId, createdAt])
}
model VotingParticipant {
  sessionId String
  session VotingSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  memberId String
  member ClubMember @relation(fields: [memberId], references: [id], onDelete: Restrict)
  joinedAt DateTime?
  ballots VotingBallot[]
  @@id([sessionId, memberId])
}
model VotingCandidate {
  sessionId String
  session VotingSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  applicationId String
  application Application @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  position Int
  expectedStatus AppStatus
  publishedStatus AppStatus?
  passes VotingPassCandidate[]
  @@id([sessionId, applicationId])
  @@unique([sessionId, position])
}
model VotingPass {
  sessionId String
  session VotingSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  number Int
  state String @default("OPEN")
  startedAt DateTime @default(now())
  completedAt DateTime?
  candidates VotingPassCandidate[]
  @@id([sessionId, number])
}
model VotingPassCandidate {
  sessionId String
  passNumber Int
  applicationId String
  pass VotingPass @relation(fields: [sessionId, passNumber], references: [sessionId, number], onDelete: Restrict)
  candidate VotingCandidate @relation(fields: [sessionId, applicationId], references: [sessionId, applicationId], onDelete: Restrict)
  position Int
  override String?
  overrideBy String?
  overrideAt DateTime?
  ballots VotingBallot[]
  @@id([sessionId, passNumber, applicationId])
  @@unique([sessionId, passNumber, position])
}
model VotingBallot {
  id String @id @default(uuid())
  sessionId String
  passNumber Int
  applicationId String
  memberId String
  candidate VotingPassCandidate @relation(fields: [sessionId, passNumber, applicationId], references: [sessionId, passNumber, applicationId], onDelete: Restrict)
  participant VotingParticipant @relation(fields: [sessionId, memberId], references: [sessionId, memberId], onDelete: Restrict)
  decision String
  createdAt DateTime @default(now())
  @@unique([sessionId, passNumber, applicationId, memberId])
}

// Personal revisit-later links to the existing club directory, independent of subscriptions/applications.
model CorkboardClub {
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  clubId String
  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
  savedAt DateTime @default(now())
  @@id([userId, clubId])
  @@index([clubId])
}

// Explicit, revocable grants. No legacy role/title inference.
model InterviewPanelAssignment {
  id String @id @default(uuid())
  applicationId String
  application Application @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  roundId String
  round PipelineRound @relation(fields: [roundId], references: [id], onDelete: Restrict)
  memberId String
  member ClubMember @relation(fields: [memberId], references: [id], onDelete: Restrict)
  grantedBy String
  grantor User @relation("InterviewPanelGrantor", fields: [grantedBy], references: [id], onDelete: Restrict, onUpdate: NoAction)
  grantedAt DateTime @default(now())
  revokedAt DateTime?
  bookingManaged Boolean @default(false)
  bookingId String?
  booking InterviewBooking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  @@index([bookingId])
  @@unique([applicationId, roundId, memberId])
  @@index([memberId, roundId, revokedAt])
}
model InterviewResumeDocument {
  id String @id @default(uuid())
  applicationId String
  application Application @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  roundId String
  round PipelineRound @relation(fields: [roundId], references: [id], onDelete: Restrict)
  sourcePath String
  contentHash String
  // Immutable snapshot bytes, bounded to the existing 10MB resume limit.
  // Private PostgreSQL storage avoids a second storage capability/retention policy.
  content Bytes
  mimeType String @default("application/pdf")
  createdAt DateTime @default(now())
  annotations InterviewResumeAnnotation[]
  @@unique([applicationId, roundId])
}
model InterviewResumeAnnotation {
  id String @id @default(uuid())
  documentId String
  document InterviewResumeDocument @relation(fields: [documentId], references: [id], onDelete: Restrict)
  authorId String
  author ClubMember @relation(fields: [authorId], references: [id], onDelete: Restrict)
  kind String
  anchor Json?
  comment String
  revision Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
  history InterviewAnnotationRevision[]
  @@index([documentId, createdAt])
}
model InterviewAnnotationRevision {
  id String @id @default(uuid())
  annotationId String
  annotation InterviewResumeAnnotation @relation(fields: [annotationId], references: [id], onDelete: Restrict)
  actorId String
  actor User @relation("InterviewAnnotationActor", fields: [actorId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  revision Int
  content Json
  createdAt DateTime @default(now())
  @@unique([annotationId, revision])
}
