{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(gh pr list *)",
      "Bash(gh pr view *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(pnpm run test)",
      "Bash(pnpm run test:migrations)",
      "Bash(pnpm run test:agent-hooks)",
      "Bash(pnpm run lint)",
      "Bash(pnpm run typecheck)",
      "Bash(node scripts/check-disposable-integration-coverage.cjs)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git merge *)",
      "Bash(git reset *)",
      "Bash(git clean *)",
      "Bash(pnpm install *)",
      "Bash(pnpm add *)",
      "Bash(npx *)",
      "Bash(vercel *)",
      "Bash(supabase *)",
      "Bash(prisma *)",
      "Bash(pnpm prisma *)",
      "Bash(pnpm run db:deploy)",
      "Bash(psql *)",
      "Bash(curl *)",
      "mcp__vercel__create_deployment",
      "mcp__vercel__request_promote",
      "mcp__vercel__request_rollback",
      "mcp__vercel__create_project_env",
      "mcp__vercel__edit_project_env",
      "mcp__vercel__update_project",
      "mcp__supabase__apply_migration",
      "mcp__supabase__execute_sql",
      "mcp__supabase__deploy_edge_function"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)",
      "Read(*.pem)",
      "Read(*.key)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(supabase db reset *)",
      "Bash(prisma migrate reset *)",
      "Bash(pnpm prisma migrate reset *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-bash.cjs\"",
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
