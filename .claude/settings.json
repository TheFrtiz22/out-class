{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(gh pr list *)",
      "Bash(gh pr view *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(pnpm run test)",
      "Bash(pnpm run test:migrations)",
      "Bash(pnpm run test:agent-hooks)",
      "Bash(pnpm run lint)",
      "Bash(pnpm run typecheck)",
      "Bash(node scripts/check-disposable-integration-coverage.cjs)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git merge *)",
      "Bash(git reset *)",
      "Bash(git clean *)",
      "Bash(pnpm install *)",
      "Bash(pnpm add *)",
      "Bash(npx *)",
      "Bash(vercel *)",
      "Bash(supabase *)",
      "Bash(prisma *)",
      "Bash(pnpm prisma *)",
      "Bash(pnpm run db:deploy)",
      "Bash(psql *)",
      "Bash(curl *)",
      "mcp__vercel__create_deployment",
      "mcp__vercel__request_promote",
      "mcp__vercel__request_rollback",
      "mcp__vercel__create_project_env",
      "mcp__vercel__edit_project_env",
      "mcp__vercel__update_project",
      "mcp__vercel__pause_project",
      "mcp__vercel__assign_alias",
      "mcp__vercel__add_project_domain",
      "mcp__vercel__create_record",
      "mcp__vercel__update_record",
      "mcp__vercel__replace_domain_dns_records",
      "mcp__vercel__update_firewall_config",
      "mcp__vercel__put_firewall_config",
      "mcp__vercel__update_project_protection_bypass",
      "mcp__vercel__buy_domain",
      "mcp__claude_ai_Vercel__create_deployment",
      "mcp__claude_ai_Vercel__request_promote",
      "mcp__claude_ai_Vercel__request_rollback",
      "mcp__claude_ai_Vercel__create_project_env",
      "mcp__claude_ai_Vercel__edit_project_env",
      "mcp__claude_ai_Vercel__update_project",
      "mcp__claude_ai_Vercel__pause_project",
      "mcp__claude_ai_Vercel__assign_alias",
      "mcp__claude_ai_Vercel__add_project_domain",
      "mcp__claude_ai_Vercel__create_record",
      "mcp__claude_ai_Vercel__update_record",
      "mcp__claude_ai_Vercel__replace_domain_dns_records",
      "mcp__claude_ai_Vercel__update_firewall_config",
      "mcp__claude_ai_Vercel__put_firewall_config",
      "mcp__claude_ai_Vercel__update_project_protection_bypass",
      "mcp__claude_ai_Vercel__buy_domain",
      "mcp__supabase__apply_migration",
      "mcp__supabase__execute_sql",
      "mcp__supabase__deploy_edge_function",
      "mcp__supabase__create_edge_function_secret",
      "mcp__supabase__create_project",
      "mcp__supabase__pause_project",
      "mcp__supabase__restore_project",
      "mcp__supabase__create_branch",
      "mcp__supabase__delete_branch",
      "mcp__supabase__merge_branch",
      "mcp__supabase__reset_branch",
      "mcp__supabase__rebase_branch",
      "mcp__claude_ai_Supabase__apply_migration",
      "mcp__claude_ai_Supabase__execute_sql",
      "mcp__claude_ai_Supabase__deploy_edge_function",
      "mcp__claude_ai_Supabase__create_edge_function_secret",
      "mcp__claude_ai_Supabase__create_project",
      "mcp__claude_ai_Supabase__pause_project",
      "mcp__claude_ai_Supabase__restore_project",
      "mcp__claude_ai_Supabase__create_branch",
      "mcp__claude_ai_Supabase__delete_branch",
      "mcp__claude_ai_Supabase__merge_branch",
      "mcp__claude_ai_Supabase__reset_branch",
      "mcp__claude_ai_Supabase__rebase_branch",
      "mcp__resend__send-email",
      "mcp__resend__send-batch-emails",
      "mcp__resend__send-broadcast",
      "mcp__resend__send-new-inbox-email",
      "mcp__resend__send-inbox-draft",
      "mcp__resend__reply-to-inbox-thread-email",
      "mcp__resend__forward-inbox-thread-email",
      "mcp__claude_ai_Resend__send-email",
      "mcp__claude_ai_Resend__send-batch-emails",
      "mcp__claude_ai_Resend__send-broadcast",
      "mcp__claude_ai_Resend__send-new-inbox-email",
      "mcp__claude_ai_Resend__send-inbox-draft",
      "mcp__claude_ai_Resend__reply-to-inbox-thread-email",
      "mcp__claude_ai_Resend__forward-inbox-thread-email"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)",
      "Read(*.pem)",
      "Read(*.key)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(supabase db reset *)",
      "Bash(prisma migrate reset *)",
      "Bash(pnpm prisma migrate reset *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-bash.cjs\"",
            "onFailure": "block"
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "cloudflare": {
      "source": {
        "source": "github",
        "repo": "cloudflare/skills"
      }
    }
  },
  "enabledPlugins": {
    "cloudflare@cloudflare": true
  }
}
